# name: test/sql/duckdb2/default_schema.test
# description: DuckDB 2 preserves catalogs without an implicit default schema
# group: [vgi_duckdb2_protocol]

require-env VGI_DEFAULT_SCHEMA_NONE_WORKER

require-env VGI_DEFAULT_SCHEMA_MAIN_WORKER

require-env VGI_DEFAULT_SCHEMA_DOTTED_WORKER

require vgi

statement ok
ATTACH 'default_schema_probe' AS probe (TYPE vgi, LOCATION '${VGI_DEFAULT_SCHEMA_NONE_WORKER}');

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'probe';
----
1

query I
SELECT count(*) FROM duckdb_settings() WHERE name = 'vgi_default_schema_probe_setting';
----
1

# A missing implicit default does not prevent explicitly qualified access.
query I
SELECT value FROM probe.main.marker;
----
11

query I
SELECT value FROM probe."root.with.dot".marker;
----
22

statement error
SELECT value FROM probe.marker;
----

statement ok
DETACH probe;

# The detached alias can be reused, and the ordinary main default still works.
statement ok
ATTACH 'default_schema_probe' AS probe (TYPE vgi, LOCATION '${VGI_DEFAULT_SCHEMA_MAIN_WORKER}');

query I
SELECT value FROM probe.marker;
----
11

query I
SELECT count(*) FROM duckdb_settings() WHERE name = 'vgi_default_schema_probe_setting';
----
1

statement ok
DETACH probe;

statement ok
ATTACH 'default_schema_probe' AS probe (TYPE vgi, LOCATION '${VGI_DEFAULT_SCHEMA_DOTTED_WORKER}');

query I
SELECT value FROM probe.marker;
----
22

query I
SELECT value FROM probe."root.with.dot".marker;
----
22

query I
SELECT value FROM probe.main.marker;
----
11

query T
SELECT schema_name FROM duckdb_schemas() WHERE database_name = 'probe' ORDER BY schema_name;
----
main
root.with.dot

statement ok
DETACH probe;

query I
SELECT 42;
----
42
