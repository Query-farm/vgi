# name: test/sql/duckdb2/view_alias_metadata.test
# description: Raw aliases from discovery remain ordered; malformed lists fail closed.
# group: [vgi_duckdb2_protocol]

require-env VGI_VIEW_ALIAS_WORKER

require vgi

# Explicitly enable bulk discovery; each fixture selects its intended path.
statement ok
SET vgi_catalog_contents=true;

statement ok
ATTACH 'views' AS v (TYPE vgi, LOCATION '${VGI_VIEW_ALIAS_WORKER}');

query II
SELECT "a.b", "with""quote" FROM v.main.v;
----
11	22

statement ok
DETACH v;

statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_ALIAS_MODE=missing ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
aliases

statement ok
DETACH bad;

statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_ALIAS_MODE=null ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
aliases

statement ok
DETACH bad;

statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_ALIAS_MODE=null_item ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
aliases

statement ok
DETACH bad;

statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_ALIAS_MODE=empty ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
aliases

statement ok
DETACH bad;

statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_ALIAS_MODE=nul ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
aliases

statement ok
DETACH bad;


statement ok
SET vgi_eager_load_threshold = MAP {'view': 0};

# Security mode missing through get metadata.
statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_SECURITY_MODE=missing VGI_VIEW_METADATA_PATH=get ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM bad.main.v;
----
security

statement ok
DETACH bad;

# Security mode missing through listing metadata.
statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_SECURITY_MODE=missing VGI_VIEW_METADATA_PATH=listing ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM duckdb_views() WHERE database_name = 'bad';
----
security

statement ok
DETACH bad;

# Malformed bulk framing is checked through the direct diagnostic: ordinary
# discovery may fall back to per-schema RPCs after a rejected optional snapshot.
# Security mode missing through bulk metadata.
statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_SECURITY_MODE=missing VGI_VIEW_METADATA_PATH=bulk ${VGI_VIEW_ALIAS_WORKER}');

statement error
SELECT * FROM vgi_catalog_contents('bad');
----
catalog_contents: 'views' stream has an incompatible metadata schema

statement ok
DETACH bad;

# Security mode null through get metadata.
statement ok
ATTACH 'views' AS bad (TYPE vgi, LOCATION 'env VGI_VIEW_SECURITY_MODE=null VGI_VIEW_METADATA_PATH=get ${VGI_VIEW_ALIAS_WORKER}');

statement error
