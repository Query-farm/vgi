# name: test/sql/external_storage/arguments_ref_state_ref.test
# description: A scan whose init request is large (a 1000-value IN list) carries it as a stored init StateRef (protocol 3.4)
# group: [vgi_external_storage]
#
# Lane: make test_http_vendor, with a worker that carries its init request as
# a vgi-rpc StateRef in its cursor (docs/large-values-3.4.md §6) and a fake
# vendor with the StateRef counters (vgi-rpc STATE_REF_V1.md §10.3). The lane
# sets VGI_WORKER_INIT_STATE_REF=1 for such a worker; until vgi-python ships it
# this file skips with that reason, which the lane lists as expected.
#
# Under the lane's 32 KiB request cap the inline limit is about 5 KB
# (turn_budget / 4, STATE_REF_V1.md §9), so a 1000-value IN list of random
# 64-bit keys (~8 KB raw, ~5-6 KB compressed) pushes the init over it: the
# worker stores the init once (`puts_state_ref`, a server write, not a client
# upload) and every continuation carries the ~130-byte tag. The filters and
# join keys live in the init request, so this is how they stay out of every
# turn. No turn needs a whole-request upload.

require-env VGI_WORKER_INIT_STATE_REF

require-env VGI_BLOB_VENDOR_URL

require-env VGI_RPC_MAX_REQUEST_BYTES

require-env VGI_TEST_WORKER

require vgi

require httpfs

require json

statement ok
SET threads=1;

query I
SELECT ok FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__admin__/reset');
----
true

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE TABLE s0 AS SELECT * FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__stats__');

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

# 20 of the 1000 keys fall in the scanned range (multiples of 997).
query II
SELECT count(*), sum(n) FROM example.echo((SELECT range AS n FROM range(0, 20000)))
