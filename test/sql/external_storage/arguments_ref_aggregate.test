# name: test/sql/external_storage/arguments_ref_aggregate.test
# description: Aggregates never use argument references (regression); their large inputs keep the whole-request upload
# group: [vgi_external_storage]
#
# Lane: make test_http_vendor. Protocol 3.4 excludes aggregates from argument
# references (docs/large-values-3.4.md §5a, "Scope"): Update, Combine and
# Finalize carry an execution_id, not bind_call, and the aggregate bind is its
# own AggregateBindRequest. Whatever the worker advertises, an aggregate over
# large values must keep working through the unchanged path: no argument
# reference is ever minted (vgi_http_request_stats), and inputs over the 32 KiB
# request cap still go up whole.

require-env VGI_BLOB_VENDOR_URL

require-env VGI_TEST_WORKER

require vgi

require httpfs

require json

statement ok
SET threads=1;

query I
SELECT ok FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__admin__/reset');
----
true

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

# 40 distinct 2 KiB strings: one 80 KiB update batch, over the request cap.
query II
SELECT strlen(r), md5(r) = (SELECT md5(string_agg(repeat(chr((97 + i % 26)::INTEGER), 2048) || i::VARCHAR, ',' ORDER BY i))
                            FROM range(40) t(i))
FROM (SELECT example.main.vgi_listagg(s ORDER BY i) AS r
      FROM (SELECT i, repeat(chr((97 + i % 26)::INTEGER), 2048) || i::VARCHAR AS s FROM range(40) t(i)));
----
82029	true

query II
SELECT sum(arguments_ref_uploads), sum(request_uploads) >= 1 FROM vgi_http_request_stats();
----
0	true

statement ok
DETACH example;
