# name: test/sql/external_storage/arguments_ref.test
# description: A large argument goes up once per query and travels as BindRequest.arguments_location (protocol 3.4 argument references)
# group: [vgi_external_storage]
#
# Lane: make test_http_vendor, with a worker that implements protocol 3.4
# argument references (docs/large-values-3.4.md §2-§5a) and the large-value
# fixtures of docs/testing/blob-test-catalog.md. The lane sets
# VGI_WORKER_ARGUMENTS_REF=1 for such a worker; until vgi-python ships them
# this file skips with that reason, which the lane lists as expected.
#
# The worker advertises VGI-Arguments-Ref-Bytes (4 MiB by default), so under
# the lane's 32 KiB VGI-Max-Request-Bytes an argument over 32768 / 4 = 8192
# bytes is hashed, uploaded once through __upload_url__/init (a client-upload
# grant carrying a sealed `ref`), and every request that embeds the bind
# carries the ~100-byte reference instead. The extension's counters
# (vgi_http_request_stats) and the vendor's (__stats__) prove it: one client
# upload of exactly the argument, no whole-request upload, and every request
# under the cap.

require-env VGI_WORKER_ARGUMENTS_REF

require-env VGI_BLOB_VENDOR_URL

require-env VGI_RPC_MAX_REQUEST_BYTES

require-env VGI_TEST_WORKER

require vgi

require httpfs

require json

statement ok
SET threads=1;

query I
SELECT ok FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__admin__/reset');
----
true

statement ok
ATTACH 'blob_test' AS bt (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# 8 MiB that does not compress well (hex digests). CI-sized: the 300 MB run is
# the manual definition-of-done measurement.
statement ok
SET VARIABLE big = (SELECT string_agg(md5(i::VARCHAR), '' ORDER BY i) FROM range(262144) t(i));

query I
SELECT strlen(getvariable('big'));
----
8388608

# --- 1. one upload per query --------------------------------------------------

statement ok
CREATE TABLE s0 AS SELECT * FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__stats__');

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

query II
SELECT payload_len, payload_sha256 = sha256(getvariable('big')) FROM bt.blob_param_echo(getvariable('big'));
----
8388608	true

statement ok
CREATE TABLE s1 AS SELECT * FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__stats__');

# Exactly one client upload, of the argument IPC (a little over the 8 MiB of
# text), and nothing else went up.
query III
SELECT s1.client_uploads - s0.client_uploads, s1.client_upload_bytes - s0.client_upload_bytes >= 8388608,
       s1.client_upload_bytes - s0.client_upload_bytes < 8388608 + 4096
FROM s0, s1;
----
1	true	true

query IIII
SELECT sum(arguments_ref_uploads), sum(request_uploads), max(max_request_bytes) < ${VGI_RPC_MAX_REQUEST_BYTES},
       max(max_request_bytes) < 16384
FROM vgi_http_request_stats();
----
1	0	true	true

# A small argument stays inline: no upload at all.
statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

query II
SELECT payload_len, payload_sha256 = sha256('small') FROM bt.blob_param_echo('small');
----
5	true

query II
SELECT sum(arguments_ref_uploads), sum(request_uploads) FROM vgi_http_request_stats();
----
0	0

# --- 2. a producer of >= 50 batches stays under the turn budget ---------------
#
# Every continuation carries the stream state (cursor + call token). With the
# argument by reference, the init request in the cursor holds the reference,
# not the argument, so no turn approaches VGI-Max-Request-Bytes and no request
# needs a whole-request upload.

statement ok
CREATE TABLE s2 AS SELECT * FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__stats__');

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

query IIII
SELECT count(*), count(DISTINCT i), bool_and(payload_len = 8388608),
       bool_and(payload_sha256 = sha256(getvariable('big')))
FROM bt.blob_param_batches(getvariable('big'), 60);
----
60	60	true	true

statement ok
CREATE TABLE s3 AS SELECT * FROM read_json_auto('${VGI_BLOB_VENDOR_URL}/__stats__');

query IIIII
SELECT sum(requests) >= 60, sum(arguments_ref_uploads), sum(request_uploads),
       max(max_request_bytes) < ${VGI_RPC_MAX_REQUEST_BYTES}, max(max_request_bytes) < 16384
FROM vgi_http_request_stats();
----
true	1	0	true	true

query I
SELECT s3.client_uploads - s2.client_uploads FROM s2, s3;
----
1

# --- 4. a scalar with a large constant argument -------------------------------
#
# The constant parameter rides the scalar's bind; the per-row input does not.

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

query III
SELECT count(*), bool_and(h = sha256(getvariable('big'))), count(h)
FROM (SELECT bt.blob_param_scalar(i, getvariable('big')) AS h FROM range(5000) t(i));
----
5000	true	5000

query II
SELECT sum(arguments_ref_uploads), max(max_request_bytes) < ${VGI_RPC_MAX_REQUEST_BYTES}
FROM vgi_http_request_stats();
----
1	true

# --- 11. a serialized-plan rebind reuses the reference ------------------------
#
# blob_param_table is a catalog table whose scan binds blob_param_echo with a
# fixed 64 KiB argument and reports STABLE_WITHIN_QUERY. The recursive CTE
# copies the plan, which rebinds the scan in VgiTableScanDeserialize and
# compares the rebuilt bind request byte for byte. The per-query memo makes the
# rebind reuse the first upload's reference, so the bytes match (no
# "Repeatable VGI source bind state changed") and there is one upload.

statement ok
SELECT count(*) FROM vgi_http_request_stats(reset => true);

query I
WITH RECURSIVE r(i) AS (
    SELECT 0
    UNION ALL
    SELECT r.i + 1 FROM bt.main.blob_param_table s CROSS JOIN r
    WHERE r.i < 2 AND s.payload_len = 65536 AND s.payload_sha256 = sha256(repeat('t', 65536)))
SELECT i FROM r ORDER BY i;
----
0
1
2

query II
SELECT sum(arguments_ref_uploads), sum(arguments_ref_reuses) >= 1 FROM vgi_http_request_stats();
----
1	true

statement ok
DETACH bt;
