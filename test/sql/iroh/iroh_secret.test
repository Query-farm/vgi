# name: test/sql/iroh/iroh_secret.test
# description: Iroh transport identity secrets are registered, scoped, and redacted
# group: [vgi_iroh]

require vgi

query I
SELECT count(*) FROM duckdb_secret_types() WHERE type = 'iroh';
----
1

statement ok
CREATE SECRET iroh_test_identity (
    TYPE iroh,
    SECRET_KEY 'must-never-appear-in-introspection',
    SCOPE 'iroh://0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
);

query I
SELECT count(*)
FROM duckdb_secrets()
WHERE name = 'iroh_test_identity'
  AND type = 'iroh'
  AND list_contains(scope, 'iroh://0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef');
----
1

query I
SELECT count(*)
FROM duckdb_secrets()
WHERE name = 'iroh_test_identity'
  AND secret_string LIKE '%must-never-appear-in-introspection%';
----
0

statement ok
DROP SECRET iroh_test_identity;
