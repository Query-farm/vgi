# name: test/sql/integration/table_in_out/continuation_cache.test
# description: The result cache never holds partial or continued output. A LIMIT that
#   stops a query partway through must not leave an entry that a later query would
#   serve as the whole answer (stock in-out and batched LATERAL), and a chunk whose
#   calls (input_rows_per_call) are partly continued, or partly served from per-value
#   entries, stores per-value entries only for the calls answered in one reply.
#
#   Fixture: paged_explode (continuation_classic.test). The batched-LATERAL and
#   input_rows_per_call cases pass named arguments to a correlated call, so they are
#   in continuation_cache_named_args.test (duckdb/duckdb#27833). Each section uses
#   its own cache_ttl, so its cache key is its own.
# group: [vgi_integration_table_in_out]

require-env VGI_TEST_WORKER

require vgi

# HTTP transport ATTACH needs httpfs loaded. Harmless on subprocess.
require httpfs

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET threads = 1;

statement ok
CALL enable_logging(level := 'debug');

# ---------------------------------------------------------------------------
# Stock in-out, a LIMIT met by a reply that says more: nothing is stored, so the
# full query asks the worker and gets every row (0..1999 sum to 1999000).
# ---------------------------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT i FROM ex.paged_explode((SELECT 2000 AS n), page_size := 10, cache_ttl := 302) LIMIT 5);
----
5

query I
SELECT count(*)
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'result_cache.store'
  AND message LIKE '%paged_explode%';
----
0

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(i) FROM ex.paged_explode((SELECT 2000 AS n), page_size := 10, cache_ttl := 302);
----
2000	1999000

query II
SELECT
  count(*) FILTER (WHERE regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'result_cache.hit'),
  count(*) FILTER (WHERE regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'result_cache.store')
FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%paged_explode%';
----
0	0

# A LIMIT met by an input's only reply: that reply is the input's whole output, so
# it is stored whole (not the 5 rows the LIMIT kept) and serves the full query
# without the worker.
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT i FROM ex.paged_explode((SELECT 2000 AS n), page_size := 1000000, cache_ttl := 303) LIMIT 5);
----
5

query I
SELECT count(*) > 0
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'result_cache.store'
  AND message LIKE '%paged_explode%';
----
true

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(i) FROM ex.paged_explode((SELECT 2000 AS n), page_size := 1000000, cache_ttl := 303);
----
2000	1999000

query II
SELECT
  count(*) FILTER (WHERE regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'result_cache.hit'),
  count(*) FILTER (WHERE regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'table_in_out.write_input')
FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%paged_explode%';
----
1	0

statement ok
CALL disable_logging();

statement ok
RESET threads;

statement ok
DETACH ex;