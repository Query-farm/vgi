# name: test/sql/integration/table_in_out/correlated_named_args_unsupported.test
# description: On an engine without duckdb/duckdb#27833 (upstream DuckDB v2.0.0), a
#   correlated table-function call with named arguments fails to bind, while the same
#   call without them, and a literal call with them, work. The *_named_args.test files
#   skip there.
#
#   This is the canary for that skip: it asserts the binder really rejects the call.
#   When an upstream release ships #27833, this file fails. Then switch
#   VGI_ENGINE_HAS_CORRELATED_NAMED_ARGS (src/include/vgi_engine_compat.hpp) and the
#   Makefile's VGI_ENGINE_CORRELATED_NAMED_ARGS to that version, so the
#   *_named_args.test files run (docs/upstream-duckdb-build.md).
# group: [vgi_integration_table_in_out]

require-env VGI_TEST_WORKER

require-env-not VGI_ENGINE_CORRELATED_NAMED_ARGS

require vgi

# HTTP transport ATTACH needs httpfs loaded. Harmless on subprocess.
require httpfs

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement error
SELECT x, i FROM range(4) t(x), LATERAL ex.blended_paged(t.x, page_size := 1);
----
No function matches

statement error
SELECT x, i FROM range(4) t(x), LATERAL ex.blended_sliced(t.x, cache_ttl := 1);
----
No function matches

# Without named arguments the correlated call binds...
query I
SELECT count(*) FROM range(4) t(x), LATERAL ex.blended_paged(t.x);
----
6

# ...and so does a literal call with them.
query I
SELECT count(*) FROM ex.blended_paged(4, page_size := 1);
----
4

statement ok
DETACH ex;
