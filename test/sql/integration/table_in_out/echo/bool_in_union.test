# name: test/sql/integration/table_in_out/echo/bool_in_union.test
# description: BOOLEAN values survive the Arrow IPC round-trip inside dense unions
# group: [vgi_integration_table_in_out_echo]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
SET arrow_lossless_conversion = true;

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

query I
SELECT u FROM example.echo((SELECT true AS u));
----
true

query I
SELECT u FROM example.echo((SELECT false AS u));
----
false

query I
SELECT u FROM example.echo((SELECT union_value(b := false)::UNION(i INT, b BOOLEAN) AS u));
----
false

query I
SELECT u FROM example.echo((SELECT union_value(b := true)::UNION(i INT, b BOOLEAN) AS u));
----
true

query I
SELECT u FROM example.echo((
    SELECT * FROM (VALUES
        (union_value(b := true)::UNION(i INT, b BOOLEAN)),
        (union_value(b := true)),
        (union_value(b := true)),
        (union_value(b := true))
    ) t(u)
));
----
true
true
true
true

query I
SELECT u FROM example.echo((
    SELECT * FROM (VALUES
        (union_value(b := true)::UNION(i INT, s VARCHAR, b BOOLEAN)),
        (union_value(b := false)),
        (union_value(b := true)),
        (union_value(b := false)),
        (union_value(b := true))
    ) t(u)
));
----
true
false
true
false
true

query I
SELECT u FROM example.echo((
    SELECT * FROM (VALUES
        (union_value(i := 1)::UNION(i INT, s VARCHAR, b BOOLEAN)),
        (union_value(b := true)),
        (union_value(s := 'x')),
        (union_value(b := true))
    ) t(u)
));
----
1
true
x
true

statement ok
DETACH example;
