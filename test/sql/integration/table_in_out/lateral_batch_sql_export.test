# name: test/sql/integration/table_in_out/lateral_batch_sql_export.test
# description: Batched LATERAL SQL export preserves correlation, projections and result types.
# group: [vgi_integration_table_in_out]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '{VGI_TEST_WORKER}');

statement ok
SET vgi_batch_lateral=true;

# Prove that export exercises the extension operator, including a pruned output.
query TT
EXPLAIN SELECT x, b FROM range(4) t(x), LATERAL ex.projectable_blended(t.x);
----
physical_plan	<REGEX>:.*Vgi Lateral Batch.*

statement ok
CALL enable_logging(level := 'debug');

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN (SQL) SELECT x, b FROM range(4) t(x), LATERAL ex.projectable_blended(t.x) WHERE b >= 200;

# Binding may contact the worker, but exporting must not exchange input rows.
query I
SELECT count(*) FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%table_in_out.write_input%';
----
0

statement ok
CALL disable_logging();

# Strict verification executes the reconstructed SQL and refuses unsupported
# export, so these same expected rows validate both execution paths.
foreach mode none explain_sql_strict

statement ok
SET debug_verify_statement='{mode}';

# Non-leading output column, residual filter, duplicates and NULL correlation.
query IIT rowsort
SELECT x, b, typeof(b)
FROM (VALUES (1::BIGINT), (2), (2), (NULL)) t(x), LATERAL ex.projectable_blended(t.x)
WHERE b >= 200 OR b IS NULL;
----
2	200	BIGINT
2	200	BIGINT
NULL	NULL	BIGINT

# Fan-out and empty outputs, with duplicate inputs preserved.
query II rowsort
SELECT x, i FROM (VALUES (0::BIGINT), (2), (2), (3)) t(x), LATERAL ex.blended_explode(t.x);
----
2	0
2	0
2	1
2	1
3	0
3	1
3	2

query II rowsort
SELECT x, i FROM (VALUES (0::BIGINT), (2), (NULL)) t(x)
LEFT JOIN LATERAL ex.blended_explode(t.x) ON true;
----
0	NULL
2	0
2	1
NULL	NULL

# Both extension nodes must export their current child plans.
query III rowsort
SELECT x, p.b, q.b
FROM range(3) t(x), LATERAL ex.projectable_blended(t.x) p,
     LATERAL ex.projectable_blended(p.b) q;
----
0	0	0
1	100	10000
2	200	20000

# Multiple positional arguments, including a constant and a correlated expression.
query IT rowsort
SELECT row_sum, typeof(row_sum)
FROM (VALUES (1::DOUBLE), (2), (NULL)) t(x), LATERAL ex.row_sum(t.x, t.x * 2, 5.0);
----
11.0	DOUBLE
8.0	DOUBLE
NULL	DOUBLE

query I
SELECT count(*) FROM range(5000) t(x), LATERAL ex.blended_explode(t.x % 3);
----
4999

endloop

statement ok
RESET debug_verify_statement;

# Execution still batches after export; a row-at-a-time fallback would write 5000 times.
statement ok
CALL enable_logging(level := 'debug');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM range(5000) t(x), LATERAL ex.blended_explode(t.x % 3);
----
4999

query I
SELECT count(*) BETWEEN 1 AND 99 FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%table_in_out.write_input%' AND message LIKE '%blended_explode%';
----
true

statement ok
CALL disable_logging();

statement ok
DETACH ex;
