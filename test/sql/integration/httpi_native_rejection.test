# name: test/sql/integration/httpi_native_rejection.test
# description: Invalid HTTP-over-Iroh paths fail before native network I/O
# group: [vgi_integration_transport]

require vgi

# Query strings are intentionally not part of the canonical HTTPI target.
statement error
ATTACH 'remote' AS httpi_native (
  TYPE vgi,
  LOCATION 'httpi://0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef/vgi?x=1'
);
----
base path contains a forbidden character
