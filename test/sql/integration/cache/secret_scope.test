# name: test/sql/integration/cache/secret_scope.test
# description: Secret-dependent results are cached per secret FINGERPRINT — reused while the secret is unchanged, recomputed the moment it is rotated, re-fielded or dropped — and no secret value reaches a key, a log line or a diagnostic
# group: [vgi_integration_cache]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SELECT * FROM vgi_result_cache_flush();

statement ok
SET threads=1;

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'before', api_key 'key-1', port 1001, use_ssl true, timeout 1.0);

# ===========================================================================
# Functions that do NOT advertise cacheability must still see every rotation.
# ===========================================================================
query I
SELECT ex.return_secret_value() LIKE '%before%';
----
true

statement ok
DROP SECRET vgi_cache_scope_secret;

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'after', api_key 'key-2', port 1002, use_ssl false, timeout 2.0);

query I
SELECT ex.return_secret_value() LIKE '%after%';
----
true

# table-in-out discovers its dependency during the two-phase bind rather than
# through catalog metadata.
query IT
SELECT n, secret_string
FROM ex.main.secret_in_out((SELECT 1 AS n));
----
1	after

query I
SELECT COUNT(*) > 0 FROM ex.secret_demo();
----
true

statement ok
DROP SECRET vgi_cache_scope_secret;

query I
SELECT COUNT(*) FROM ex.secret_demo();
----
0

# ===========================================================================
# Cacheable secret-dependent fixtures, one per cache path:
#   producer function   ex.secret_cache_nonce()        declared secret, bind RPC
#   producer table      ex.data.secret_cache_nonce     declared secret, inline bind
#   scalar (per-value)  ex.secret_cached_scalar(x)     declared secret
#   LATERAL (per-value) ex.secret_cached_lateral(x)    two-phase secret request
# Each emits the secret's secret_string and a random nonce minted only when the
# worker really runs: an equal nonce is a HIT, a different one a MISS.
#
# The secret moves through five states:
#   S1 'sekrit-one'/'key-one'  → store
#   S1 again                   → HIT
#   S2 'sekrit-two'/'key-two'  → MISS (rotated)
#   S1 restored, same fields   → HIT on the S1 entry (keyed by value, not time)
#   S3 'sekrit-one'/'key-three'→ MISS (secret_string unchanged, another field not)
#   dropped                    → MISS (no secret at all)
# ===========================================================================
statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'sekrit-one', api_key 'key-one', port 1001, use_ssl true, timeout 1.0);

statement ok
CREATE TABLE fn_s1 AS SELECT secret_string, nonce FROM ex.secret_cache_nonce();

statement ok
CREATE TABLE tbl_s1 AS SELECT secret_string, nonce FROM ex.data.secret_cache_nonce;

statement ok
CREATE TABLE sc_s1 AS SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x);

statement ok
CREATE TABLE lat_s1 AS SELECT x, l.secret_string, l.nonce FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l;

query TT
SELECT (SELECT secret_string FROM fn_s1), (SELECT secret_string FROM tbl_s1);
----
sekrit-one	sekrit-one

query I
SELECT COUNT(*) FROM sc_s1 WHERE v LIKE 'sekrit-one|%';
----
3

query I
SELECT COUNT(*) FROM lat_s1 WHERE secret_string = 'sekrit-one';
----
6

# The table scan really took the inline-bind path (no bind RPC), so its key came
# from the secrets resolved client-side for init.
query I
SELECT COUNT(*) >= 1 FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%table_function.inline_bind_used%' AND message LIKE '%secret_cache_nonce%';
----
true

# --- S1 again: unchanged secret → every shape is a HIT -----------------------
query I
SELECT (SELECT nonce FROM ex.secret_cache_nonce()) = (SELECT nonce FROM fn_s1);
----
true

query I
SELECT (SELECT nonce FROM ex.data.secret_cache_nonce) = (SELECT nonce FROM tbl_s1);
----
true

query I
SELECT COUNT(*) FROM (SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x)) q JOIN sc_s1 USING (x)
WHERE q.v = sc_s1.v;
----
3

query I
SELECT COUNT(*) FROM (SELECT x, l.nonce FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l) q
JOIN lat_s1 USING (x) WHERE q.nonce = lat_s1.nonce;
----
6

# Entries were stored for the secret-dependent functions — they are cacheable now.
query I
SELECT COUNT(*) >= 1 FROM vgi_result_cache() WHERE function = 'secret_cache_nonce';
----
true

# --- S2: rotated → every shape MISSES and sees the new value ------------------
statement ok
DROP SECRET vgi_cache_scope_secret;

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'sekrit-two', api_key 'key-two', port 1001, use_ssl true, timeout 1.0);

query TI
SELECT secret_string, nonce <> (SELECT nonce FROM fn_s1) FROM ex.secret_cache_nonce();
----
sekrit-two	true

query TI
SELECT secret_string, nonce <> (SELECT nonce FROM tbl_s1) FROM ex.data.secret_cache_nonce;
----
sekrit-two	true

query I
SELECT COUNT(*) FROM (SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x)) q JOIN sc_s1 USING (x)
WHERE q.v LIKE 'sekrit-two|%' AND q.v <> sc_s1.v;
----
3

query I
SELECT COUNT(*) FROM (SELECT x, l.secret_string, l.nonce FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l) q
JOIN lat_s1 USING (x) WHERE q.secret_string = 'sekrit-two' AND q.nonce <> lat_s1.nonce;
----
6

# --- S1 restored with identical fields → HIT on the S1 entries ----------------
statement ok
DROP SECRET vgi_cache_scope_secret;

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'sekrit-one', api_key 'key-one', port 1001, use_ssl true, timeout 1.0);

query TI
SELECT secret_string, nonce = (SELECT nonce FROM fn_s1) FROM ex.secret_cache_nonce();
----
sekrit-one	true

query TI
SELECT secret_string, nonce = (SELECT nonce FROM tbl_s1) FROM ex.data.secret_cache_nonce;
----
sekrit-one	true

query I
SELECT COUNT(*) FROM (SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x)) q JOIN sc_s1 USING (x)
WHERE q.v = sc_s1.v;
----
3

query I
SELECT COUNT(*) FROM (SELECT x, l.nonce FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l) q
JOIN lat_s1 USING (x) WHERE q.nonce = lat_s1.nonce;
----
6

# --- S3: same secret_string, different api_key → MISS -------------------------
# The fingerprint covers every field, not just the one a fixture happens to read.
statement ok
DROP SECRET vgi_cache_scope_secret;

statement ok
CREATE SECRET vgi_cache_scope_secret (TYPE vgi_example, secret_string 'sekrit-one', api_key 'key-three', port 1001, use_ssl true, timeout 1.0);

query TI
SELECT secret_string, nonce <> (SELECT nonce FROM fn_s1) FROM ex.secret_cache_nonce();
----
sekrit-one	true

query TI
SELECT secret_string, nonce <> (SELECT nonce FROM tbl_s1) FROM ex.data.secret_cache_nonce;
----
sekrit-one	true

query I
SELECT COUNT(*) FROM (SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x)) q JOIN sc_s1 USING (x)
WHERE q.v LIKE 'sekrit-one|%' AND q.v <> sc_s1.v;
----
3

query I
SELECT COUNT(*) FROM (SELECT x, l.secret_string, l.nonce FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l) q
JOIN lat_s1 USING (x) WHERE q.secret_string = 'sekrit-one' AND q.nonce <> lat_s1.nonce;
----
6

# --- Dropped → MISS; the worker runs with no secret at all --------------------
statement ok
DROP SECRET vgi_cache_scope_secret;

query TI
SELECT secret_string IS NULL, nonce <> (SELECT nonce FROM fn_s1) FROM ex.secret_cache_nonce();
----
true	true

query TI
SELECT secret_string IS NULL, nonce <> (SELECT nonce FROM tbl_s1) FROM ex.data.secret_cache_nonce;
----
true	true

query I
SELECT COUNT(*) FROM (SELECT x, ex.secret_cached_scalar(x) AS v FROM range(3) t(x)) q
WHERE q.v LIKE '|%';
----
3

query I
SELECT COUNT(*) FROM (SELECT x, l.secret_string FROM range(6) t(x), LATERAL ex.secret_cached_lateral(x % 3) l) q
WHERE q.secret_string IS NULL;
----
6

# ===========================================================================
# No secret material escapes: not into a cache event, not into the cache's own
# diagnostics. Only a fingerprint is ever keyed.
# ===========================================================================
query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%result_cache%'
  AND (message LIKE '%sekrit%' OR message LIKE '%key-one%' OR message LIKE '%key-two%' OR message LIKE '%key-three%');
----
0

query I
SELECT COUNT(*) FROM vgi_result_cache() r
WHERE CAST(r AS VARCHAR) LIKE '%sekrit%' OR CAST(r AS VARCHAR) LIKE '%key-one%';
----
0

# And nothing refused to cache for want of a fingerprint.
query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI' AND message LIKE '%result_cache.ineligible%' AND message LIKE '%reason=secret_%';
----
0

statement ok
DETACH ex;

statement ok
SELECT * FROM vgi_result_cache_flush();
