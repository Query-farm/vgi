# name: test/sql/integration/cache/secret_ineligible.test
# description: Secret-dependent producer and scalar functions never probe or populate the result cache
# group: [vgi_integration_cache]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SELECT * FROM vgi_result_cache_flush();

statement ok
CREATE SECRET vgi_cache_ineligible_secret (TYPE vgi_example, secret_string 'before', api_key 'key-1', port 1001, use_ssl true, timeout 1.0);

# Scalar results must reflect rotation even when the worker advertises per-value
# cacheability. The ineligibility event contains only the reason, never secret data.
query I
SELECT ex.return_secret_value() LIKE '%before%';
----
true

statement ok
DROP SECRET vgi_cache_ineligible_secret;

statement ok
CREATE SECRET vgi_cache_ineligible_secret (TYPE vgi_example, secret_string 'after', api_key 'key-2', port 1002, use_ssl false, timeout 2.0);

query I
SELECT ex.return_secret_value() LIKE '%after%';
----
true

# Per-value diagnostics intentionally aggregate by arena rather than exposing the
# function name. A flushed process with only these scalar calls must have no arena.
query I
SELECT COUNT(*) FROM vgi_result_cache() WHERE tier = 'arena';
----
0

# Producer results likewise reflect secret removal instead of replaying the prior
# non-empty result. No producer cache entry is published.
query I
SELECT COUNT(*) > 0 FROM ex.secret_demo();
----
true

statement ok
DROP SECRET vgi_cache_ineligible_secret;

query I
SELECT COUNT(*) FROM ex.secret_demo();
----
0

query I
SELECT COUNT(*) FROM vgi_result_cache() WHERE function = 'secret_demo';
----
0

query I
SELECT COUNT(*) >= 3 FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%result_cache.ineligible%'
  AND message LIKE '%reason=secret_dependent%';
----
true

statement ok
DETACH ex;

statement ok
SELECT * FROM vgi_result_cache_flush();
