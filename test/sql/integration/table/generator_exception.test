# name: test/sql/integration/table/generator_exception.test
# description: Integration tests for VGI generator_exception table function
# group: [vgi_integration_table]

# This test requires a VGI worker to be available
# Set VGI_TEST_WORKER environment variable to the path of a VGI worker executable
require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# ============================================================================
# generator_exception function (error handling)
# Raises an exception after N batches for testing error propagation
# ============================================================================

# fail_after := 0 raises on the FIRST producer turn, i.e. during the init RPC and
# AFTER the stream header has been written. Over HTTP that response body is two
# concatenated Arrow IPC streams — a header stream (execution_id / max_workers /
# opaque_data) and a data stream under the function's own output schema — because
# an IPC stream carries exactly one schema. The error therefore rides as metadata
# on a batch in the SECOND stream. A client that reads only the first stream sees
# a perfectly valid header, finds no error, and reports a generic transport
# failure instead of this message. The other two cases below raise on a LATER
# turn, which takes a different (single-stream) path and never exercised it.
statement error
SELECT * FROM example.generator_exception(0);
----
Intentional failure after 0 batches

statement error
SELECT * FROM example.generator_exception(2);
----
Intentional failure after 2 batches

statement error
SELECT * FROM example.generator_exception(1);
----
Intentional failure after 1 batches

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DETACH example;
