# name: test/sql/integration/table/rowid_constraint_metadata.test
# description: Only ENFORCED + ALL_ROWS constraint records attach; rowid keys and METADATA_ONLY records are bad input, not fatal errors
# group: [vgi_integration_table]

# test/support/rowid_constraint_worker.py serves the simple_writable tables with
# a different set of constraint records per catalog name:
#   enforced_keys       items PRIMARY KEY (id)
#                       items_no_returning PRIMARY KEY (id), UNIQUE (name)
#                       items_insert_only PRIMARY KEY (id)
#   rowid_keys          items PRIMARY KEY (rowid)
#                       items_no_returning PRIMARY KEY (id, rowid), UNIQUE (rowid, name)
#   metadata_only_keys  items PRIMARY KEY (id), METADATA_ONLY / UNVALIDATED
# Every record except METADATA_ONLY is ENFORCED + ALL_ROWS. Informational
# (METADATA_ONLY) constraints are not supported. The fixture serves its records
# unvalidated so these assertions exercise the extension's own checks. It
# negotiates the constraint read profile only, never vgi.constraint.enforce.v1,
# yet keeps serving the tables' declared writes (vgi-python alone would serve
# them read-only).

require-env VGI_ROWID_CONSTRAINT_WORKER

require vgi

# --- Supported: ENFORCED + ALL_ROWS keys over user columns ------------------

statement ok
ATTACH 'enforced_keys' AS e (TYPE vgi, LOCATION '${VGI_ROWID_CONSTRAINT_WORKER}');

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'e' ORDER BY 1;
----
items
items_broken_returning
items_insert_only
items_no_returning

query TTT
SELECT table_name, constraint_type, constraint_column_names
FROM duckdb_constraints()
WHERE database_name = 'e' AND constraint_type IN ('PRIMARY KEY', 'UNIQUE')
ORDER BY 1, 2;
----
items	PRIMARY KEY	[id]
items_insert_only	PRIMARY KEY	[id]
items_no_returning	PRIMARY KEY	[id]
items_no_returning	UNIQUE	[name]

# The rowid pseudocolumn is not a user column, so no key can name it.
query T
SELECT column_name FROM duckdb_columns()
WHERE database_name = 'e' AND table_name = 'items' ORDER BY column_index;
----
id
name
qty

query I
SELECT count(*) FROM e.main.items;
----
0

query II
SELECT count(rowid), count(id) FROM e.main.items_no_returning;
----
0	0

# --- Writes without the constraint-enforcement profile ----------------------
# A write the table declares needs vgi.constraint.enforce.v1, which this worker
# never negotiates, so it fails at planning on the missing profile. A write the
# table does not declare is reported as unsupported first: the missing profile
# is irrelevant to it.

statement error
INSERT INTO e.main.items VALUES (1, 'a', 10);
----
constraint enforcement profile was not negotiated

statement error
UPDATE e.main.items SET qty = 1;
----
constraint enforcement profile was not negotiated

statement error
DELETE FROM e.main.items;
----
constraint enforcement profile was not negotiated

statement error
INSERT INTO e.main.items_insert_only VALUES (1, 'a');
----
constraint enforcement profile was not negotiated

# The profile is checked before the result mode: items_no_returning is
# count-only, but the missing profile is what this attach lacks.
statement error
INSERT INTO e.main.items_no_returning VALUES (1, 'a', 10) RETURNING *;
----
constraint enforcement profile was not negotiated

statement error
UPDATE e.main.items_insert_only SET name = 'b';
----
<REGEX>:.*Table '.*items_insert_only.*' does not support UPDATE.*

statement error
DELETE FROM e.main.items_insert_only;
----
<REGEX>:.*Table '.*items_insert_only.*' does not support DELETE.*

statement error
UPDATE e.main.items_insert_only SET name = 'b';
----
<!REGEX>:.*constraint enforcement profile.*

query I
SELECT count(*) FROM e.main.items;
----
0

# --- Keys naming the rowid column are rejected ------------------------------

statement ok
ATTACH 'rowid_keys' AS w (TYPE vgi, LOCATION '${VGI_ROWID_CONSTRAINT_WORKER}');

# The client used to raise an InternalException from GetStorageInfo for these,
# and because duckdb_tables() calls it for every table, listing tables
# invalidated the whole database.
statement error
SELECT table_name FROM duckdb_tables() WHERE database_name = 'w' ORDER BY 1;
----
VGI constraint protocol: constraint references a missing, ambiguous, or synthetic column

# Rejection is an ordinary input error and must not invalidate the database.
query I
SELECT 42;
----
42

# Neither an all-rowid key nor a mixed user-column/rowid key may become a
# partial SQL key.
statement error
SELECT * FROM w.main.items;
----
VGI constraint protocol: constraint references a missing, ambiguous, or synthetic column

statement error
SELECT * FROM w.main.items_no_returning;
----
VGI constraint protocol: constraint references a missing, ambiguous, or synthetic column

# --- METADATA_ONLY (informational) records are rejected ---------------------

statement ok
ATTACH 'metadata_only_keys' AS m (TYPE vgi, LOCATION '${VGI_ROWID_CONSTRAINT_WORKER}');

statement error
SELECT * FROM m.main.items;
----
VGI constraint protocol: native constraints require ENFORCED + ALL_ROWS

# The database, and the supported attachment, are still usable.
query I
SELECT 42;
----
42

query I
SELECT count(*) FROM e.main.items;
----
0
