# name: test/sql/integration/table/batch_index_stress.test_slow
# description: Stress tests for batch_index — high fanout (many small
#              partitions) and large partitions (one batch_index emits
#              many Arrow batches). Excluded from the fast suite by the
#              ``.test_slow`` suffix.
#
# Sizes: every emitted Arrow batch is its own HTTP request (one producer turn,
# ~6 ms), so each section is sized by its batch count — enough to show the
# property it tests, not more. Over subprocess they cost almost nothing.
# group: [vgi_integration_table]

require-env VGI_TEST_WORKER

require vgi

require httpfs

require json

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET threads=4;

# ============================================================================
# Many small partitions — exercises multiset bookkeeping
# ============================================================================
# 1000 rows × chunk_size=1 = 1000 partitions, far more than the 4 threads.
# Each partition emits one Arrow batch. Stresses Pipeline::batch_indexes (the
# multiset that tracks live batch_indexes across threads).

query III
SELECT COUNT(*), MIN(partition_id), MAX(partition_id)
FROM example.partitioned_batch_index_marked(1000, chunk_size := 1);
----
1000	0	999

# Ordering invariant still holds at high fanout.
query I
WITH ordered AS (
    SELECT row_number() OVER () AS rn, partition_id
    FROM example.partitioned_batch_index_marked(1000, chunk_size := 1)
)
SELECT COUNT(*)
FROM ordered a JOIN ordered b ON a.rn = b.rn + 1
WHERE a.partition_id < b.partition_id;
----
0

# ============================================================================
# Large partitions — one batch_index spans many Arrow batches
# ============================================================================
# 10 partitions × 10_000 rows each. With BATCH_SIZE = 256 in the
# fixture, one partition emits 40 Arrow batches; they all share one
# batch_index value and DuckDB's BatchedDataCollection appends them into
# a single ColumnDataCollection.

query III
SELECT COUNT(*), MIN(seq), MAX(seq)
FROM example.partitioned_batch_index_marked(100000, chunk_size := 10000);
----
100000	0	9999

# Partition boundaries are sharp — partition_id transitions exactly when
# seq wraps back to 0.
query II
SELECT partition_id, seq
FROM example.partitioned_batch_index_marked(100000, chunk_size := 10000)
WHERE seq = 9999 OR seq = 0
LIMIT 4;
----
0	0
0	9999
1	0
1	9999

# ============================================================================
# 1M-row CTAS — PhysicalBatchInsert at scale: 1000 partitions of 1000 rows,
# spanning 9 row groups (122,880 rows each)
# ============================================================================

statement ok
CREATE TABLE batch_index_1m AS
SELECT * FROM example.partitioned_batch_index(1000000);

query II
SELECT MIN(n), MAX(n) FROM batch_index_1m;
----
0	999999

# rowid order matches n order — insertion-order preservation across 1M
# rows under parallel scan.
query II
SELECT (SELECT n FROM batch_index_1m WHERE rowid = 0),
       (SELECT n FROM batch_index_1m WHERE rowid = 999999);
----
0	999999

# Every row, not just the ends: rowid i holds n = i.
query I
SELECT count(*) FROM batch_index_1m WHERE rowid <> n;
----
0

statement ok
DROP TABLE batch_index_1m;

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DETACH example;
