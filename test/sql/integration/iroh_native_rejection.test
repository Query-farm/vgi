# name: test/sql/integration/iroh_native_rejection.test
# description: Invalid raw Iroh EndpointIds fail before native network I/O
# group: [vgi_integration_transport]

require vgi

# Endpoint IDs are canonical lowercase hexadecimal and have an exact length.
statement error
ATTACH 'remote' AS iroh_native (
  TYPE vgi,
  LOCATION 'iroh://0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF'
);
----
EndpointId must be 64 lowercase hexadecimal characters
