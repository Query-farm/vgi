# name: test/sql/integration/catalog/multi_branch_capability_cache.test
# description: catalog_table_scan_branches_get is the only scan-discovery RPC
#              (protocol 3.3 removed catalog_table_scan_function_get and the
#              extension's fallback to it): every scan asks for branches, and
#              neither the removed RPC nor the old fallback event ever appears.
# group: [vgi_integration_catalog]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET enable_logging=true;

statement ok
SET enabled_log_types='VGI';

# ============================================================================
# Issue several scan queries against tables in the same VGI catalog; every
# query routes through catalog_table_scan_branches_get.
# ============================================================================

statement ok
SELECT count(*) FROM example.data.numbers;

statement ok
SELECT count(*) FROM example.data.multi_branch_numbers;

statement ok
SELECT count(*) FROM example.data.multi_branch_filtered_numbers;

statement ok
SELECT count(*) FROM example.data.numbers;

# ============================================================================
# Assert via duckdb_logs() that catalog_table_scan_branches_get fired and
# the removed catalog_table_scan_function_get did not.
# ============================================================================

query I
SELECT COUNT(*) >= 1 FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%catalog_table_scan_branches_get%';
----
true

query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%catalog_table_scan_function_get%';
----
0

# The pre-3.3 fallback event no longer exists.
query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%catalog.rpc.scan_branches.fallback%';
----
0

statement ok
SET enable_logging=false;
