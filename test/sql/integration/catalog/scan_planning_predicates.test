query I
SELECT count(*) FROM example.data.planned_events WHERE date_trunc('day', ts) = TIMESTAMPTZ '2026-10-02 00:00:00+00';
----
10

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE date_trunc('day', ts) = TIMESTAMPTZ '2026-10-02 00:00:00+00' EXCEPT ALL FROM ref WHERE date_trunc('day', ts) = TIMESTAMPTZ '2026-10-02 00:00:00+00')
    UNION ALL (FROM ref WHERE date_trunc('day', ts) = TIMESTAMPTZ '2026-10-02 00:00:00+00' EXCEPT ALL FROM example.data.planned_events WHERE date_trunc('day', ts) = TIMESTAMPTZ '2026-10-02 00:00:00+00'));
----
0

# epoch() of the timestamp
query I
SELECT count(*) FROM example.data.planned_events WHERE epoch(ts) % 7200 = 0;
----
25

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE epoch(ts) % 7200 = 0 EXCEPT ALL FROM ref WHERE epoch(ts) % 7200 = 0)
    UNION ALL (FROM ref WHERE epoch(ts) % 7200 = 0 EXCEPT ALL FROM example.data.planned_events WHERE epoch(ts) % 7200 = 0));
----
0

# timestamp cast to date
query I
SELECT count(*) FROM example.data.planned_events WHERE ts::DATE = DATE '2026-10-05';
----
10

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE ts::DATE = DATE '2026-10-05' EXCEPT ALL FROM ref WHERE ts::DATE = DATE '2026-10-05')
    UNION ALL (FROM ref WHERE ts::DATE = DATE '2026-10-05' EXCEPT ALL FROM example.data.planned_events WHERE ts::DATE = DATE '2026-10-05'));
----
0

# NOT LIKE with a date that prunes to one day: only the date is pushed
query I
SELECT count(*) FROM example.data.planned_events WHERE series NOT LIKE '%15M' AND event_date = DATE '2026-10-02';
----
6

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-02]	[event_date EQ]

# LIKE only: nothing is pushed, every day is planned, DuckDB applies the LIKE
query I
SELECT count(*) FROM example.data.planned_events WHERE series LIKE '%15M';
----
20

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-01, 2026-10-02, 2026-10-03, 2026-10-04, 2026-10-05]	NULL

# both BETWEENs are split, the ILIKE stays with DuckDB
query I
SELECT count(*) FROM example.data.planned_events WHERE event_date BETWEEN DATE '2026-10-02' AND DATE '2026-10-03' AND series ILIKE 'kx%' AND n BETWEEN 1 AND 3;
----
6

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-02, 2026-10-03]	['And(event_date GE, event_date LE)', 'And(n GE, n LE)']

# LIKE ... ESCAPE (three arguments, bind data) is not mistaken for a BETWEEN
query I
SELECT count(*) FROM example.data.planned_events WHERE ts >= TIMESTAMPTZ '2026-10-04 00:00:00+00' AND series NOT LIKE '%!%%' ESCAPE '!';
----
16

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-04, 2026-10-05]	[ts GE]

# regexp_matches with options (three arguments, bind data) is not mistaken for a BETWEEN
query I
SELECT count(*) FROM example.data.planned_events WHERE regexp_matches(series, 'gold', 'i') AND event_date <= DATE '2026-10-01';
----
2

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-01]	[event_date LE]

# an OR containing a LIKE pushes nothing
query I
SELECT count(*) FROM example.data.planned_events WHERE event_date = DATE '2026-10-01' OR series LIKE 'KXG%';
----
18

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[2026-10-01, 2026-10-02, 2026-10-03, 2026-10-04, 2026-10-05]	NULL

# contradictory dates next to a LIKE prune every day
query I
SELECT count(*) FROM example.data.planned_events WHERE event_date = DATE '2026-10-01' AND event_date = DATE '2026-10-02' AND series LIKE '%';
----
0

query TT
SELECT days::VARCHAR, filters::VARCHAR FROM read_json('${VGI_TEST_BRANCH_DIR}/planned_events_last_plan.json');
----
[]	['And(event_date EQ, event_date EQ)']

statement ok
DETACH example;
