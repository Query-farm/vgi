# timestamp BETWEEN
query I
SELECT count(*) FROM example.data.planned_events WHERE ts BETWEEN TIMESTAMPTZ '2026-10-02 03:00:00+00' AND TIMESTAMPTZ '2026-10-02 06:00:00+00';
----
4

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE ts BETWEEN TIMESTAMPTZ '2026-10-02 03:00:00+00' AND TIMESTAMPTZ '2026-10-02 06:00:00+00' EXCEPT ALL FROM ref WHERE ts BETWEEN TIMESTAMPTZ '2026-10-02 03:00:00+00' AND TIMESTAMPTZ '2026-10-02 06:00:00+00')
    UNION ALL (FROM ref WHERE ts BETWEEN TIMESTAMPTZ '2026-10-02 03:00:00+00' AND TIMESTAMPTZ '2026-10-02 06:00:00+00' EXCEPT ALL FROM example.data.planned_events WHERE ts BETWEEN TIMESTAMPTZ '2026-10-02 03:00:00+00' AND TIMESTAMPTZ '2026-10-02 06:00:00+00'));
----
0

