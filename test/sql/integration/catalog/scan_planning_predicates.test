# name: test/sql/integration/catalog/scan_planning_predicates.test
# description: Numeric, boolean, date/time and combined predicates on a filtered-planning table;
#              the combined cases also assert which day files the worker planned.
#              Generated by scripts/gen_scan_planning_predicates.py; edit that, not this file.
#              data.planned_events (vgi-python fixture) declares scan_planning='filtered':
#              every WHERE clause goes through VgiMultiScanRewriter, which splits BETWEEN and
#              encodes what the worker may use for pruning. Each case checks the count through
#              the catalog and that its rows equal the same predicate over read_parquet of the
#              same files (symmetric difference 0), so a predicate that is dropped, mis-split or
#              mis-encoded fails, not only one that crashes. Expected counts come from plain
#              DuckDB over identical data. Columns: event_date DATE, ts TIMESTAMPTZ (hourly),
#              series VARCHAR (incl. LIKE metacharacters and lower case), ticker VARCHAR (NULL
#              when n = 7), n BIGINT 0-9, price DOUBLE, flag BOOLEAN. 5 days x 10 rows.
# group: [vgi_integration_catalog]
# serial-group: planned_events (writes fixed-name files under $VGI_TEST_BRANCH_DIR that other files share)

require-env VGI_TEST_WORKER

require-env VGI_TEST_BRANCH_DIR

require vgi

require parquet

require httpfs

require json

require icu

statement ok
SET TimeZone = 'UTC';

statement ok
COPY (SELECT DATE '2026-10-01' AS event_date, to_timestamp(epoch(DATE '2026-10-01') + i * 3600) AS ts, ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] AS series, CASE WHEN i = 7 THEN NULL ELSE ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] || '-' || strftime(DATE '2026-10-01', '%d') || '-' || i END AS ticker, i::BIGINT AS n, i / 10.0 AS price, i % 2 = 0 AS flag FROM range(10) t(i)) TO '${VGI_TEST_BRANCH_DIR}/planned_events_2026-10-01.parquet' (FORMAT 'parquet');

statement ok
COPY (SELECT DATE '2026-10-02' AS event_date, to_timestamp(epoch(DATE '2026-10-02') + i * 3600) AS ts, ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] AS series, CASE WHEN i = 7 THEN NULL ELSE ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] || '-' || strftime(DATE '2026-10-02', '%d') || '-' || i END AS ticker, i::BIGINT AS n, i / 10.0 AS price, i % 2 = 0 AS flag FROM range(10) t(i)) TO '${VGI_TEST_BRANCH_DIR}/planned_events_2026-10-02.parquet' (FORMAT 'parquet');

statement ok
COPY (SELECT DATE '2026-10-03' AS event_date, to_timestamp(epoch(DATE '2026-10-03') + i * 3600) AS ts, ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] AS series, CASE WHEN i = 7 THEN NULL ELSE ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] || '-' || strftime(DATE '2026-10-03', '%d') || '-' || i END AS ticker, i::BIGINT AS n, i / 10.0 AS price, i % 2 = 0 AS flag FROM range(10) t(i)) TO '${VGI_TEST_BRANCH_DIR}/planned_events_2026-10-03.parquet' (FORMAT 'parquet');

statement ok
COPY (SELECT DATE '2026-10-04' AS event_date, to_timestamp(epoch(DATE '2026-10-04') + i * 3600) AS ts, ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] AS series, CASE WHEN i = 7 THEN NULL ELSE ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] || '-' || strftime(DATE '2026-10-04', '%d') || '-' || i END AS ticker, i::BIGINT AS n, i / 10.0 AS price, i % 2 = 0 AS flag FROM range(10) t(i)) TO '${VGI_TEST_BRANCH_DIR}/planned_events_2026-10-04.parquet' (FORMAT 'parquet');

statement ok
COPY (SELECT DATE '2026-10-05' AS event_date, to_timestamp(epoch(DATE '2026-10-05') + i * 3600) AS ts, ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] AS series, CASE WHEN i = 7 THEN NULL ELSE ['KXBTC15M', 'KXETH15M', 'KXGOLD', 'KX_AAA%GAS', 'kxwti15m'][i % 5 + 1] || '-' || strftime(DATE '2026-10-05', '%d') || '-' || i END AS ticker, i::BIGINT AS n, i / 10.0 AS price, i % 2 = 0 AS flag FROM range(10) t(i)) TO '${VGI_TEST_BRANCH_DIR}/planned_events_2026-10-05.parquet' (FORMAT 'parquet');

statement ok
CREATE VIEW ref AS FROM read_parquet('${VGI_TEST_BRANCH_DIR}/planned_events_*.parquet');

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# integer BETWEEN (split into two comparisons)
query I
SELECT count(*) FROM example.data.planned_events WHERE n BETWEEN 2 AND 4;
----
15

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE n BETWEEN 2 AND 4 EXCEPT ALL FROM ref WHERE n BETWEEN 2 AND 4)
    UNION ALL (FROM ref WHERE n BETWEEN 2 AND 4 EXCEPT ALL FROM example.data.planned_events WHERE n BETWEEN 2 AND 4));
----
0

# integer NOT BETWEEN
query I
SELECT count(*) FROM example.data.planned_events WHERE n NOT BETWEEN 2 AND 4;
----
35

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE n NOT BETWEEN 2 AND 4 EXCEPT ALL FROM ref WHERE n NOT BETWEEN 2 AND 4)
    UNION ALL (FROM ref WHERE n NOT BETWEEN 2 AND 4 EXCEPT ALL FROM example.data.planned_events WHERE n NOT BETWEEN 2 AND 4));
----
0

# BETWEEN with reversed bounds matches nothing
query I
