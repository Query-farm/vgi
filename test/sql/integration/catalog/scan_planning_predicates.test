----
0

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE n BETWEEN 4 AND 2 EXCEPT ALL FROM ref WHERE n BETWEEN 4 AND 2)
    UNION ALL (FROM ref WHERE n BETWEEN 4 AND 2 EXCEPT ALL FROM example.data.planned_events WHERE n BETWEEN 4 AND 2));
----
0

