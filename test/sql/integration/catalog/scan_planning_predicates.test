10

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE event_date = DATE '2026-10-04' EXCEPT ALL FROM ref WHERE event_date = DATE '2026-10-04')
    UNION ALL (FROM ref WHERE event_date = DATE '2026-10-04' EXCEPT ALL FROM example.data.planned_events WHERE event_date = DATE '2026-10-04'));
