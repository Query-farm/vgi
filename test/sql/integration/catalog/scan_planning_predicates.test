20

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE event_date BETWEEN DATE '2026-10-02' AND DATE '2026-10-03' EXCEPT ALL FROM ref WHERE event_date BETWEEN DATE '2026-10-02' AND DATE '2026-10-03')
    UNION ALL (FROM ref WHERE event_date BETWEEN DATE '2026-10-02' AND DATE '2026-10-03' EXCEPT ALL FROM example.data.planned_events WHERE event_date BETWEEN DATE '2026-10-02' AND DATE '2026-10-03'));
