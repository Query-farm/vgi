# timestamp lower bound
query I
SELECT count(*) FROM example.data.planned_events WHERE ts >= TIMESTAMPTZ '2026-10-03 05:00:00+00';
----
25

query I
SELECT count(*) FROM ((FROM example.data.planned_events WHERE ts >= TIMESTAMPTZ '2026-10-03 05:00:00+00' EXCEPT ALL FROM ref WHERE ts >= TIMESTAMPTZ '2026-10-03 05:00:00+00')
    UNION ALL (FROM ref WHERE ts >= TIMESTAMPTZ '2026-10-03 05:00:00+00' EXCEPT ALL FROM example.data.planned_events WHERE ts >= TIMESTAMPTZ '2026-10-03 05:00:00+00'));
