# The reported query: GROUP BY ALL over a NOT LIKE filter
query TI
SELECT series, sum(n) FROM example.data.planned_events WHERE series NOT LIKE '%15M' GROUP BY ALL ORDER BY 2 DESC, 1;
----
kxwti15m	65
KX_AAA%GAS	55
KXGOLD	45

# LIKE on one column, projecting another
query T
SELECT DISTINCT series FROM example.data.planned_events WHERE ticker LIKE '%-05-9' ORDER BY 1;
----
kxwti15m

# A prepared statement binds the LIKE pattern as a parameter
statement ok
PREPARE like_q AS SELECT count(*) FROM example.data.planned_events WHERE series LIKE $1;

query I
EXECUTE like_q('%15M');
----
20

query I
EXECUTE like_q('KX%');
----
40

# LIKE in a join condition and in a subquery
query I
SELECT count(*) FROM example.data.planned_events e JOIN (VALUES ('KXGOLD')) v(s) ON e.series LIKE v.s || '%';
----
10

query I
SELECT count(*) FROM example.data.planned_events WHERE series IN (SELECT series FROM example.data.planned_events WHERE series LIKE '%15M' AND n = 0);
----
10

statement ok
DETACH example;
