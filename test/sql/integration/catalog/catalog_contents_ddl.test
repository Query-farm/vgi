# name: test/sql/integration/catalog/catalog_contents_ddl.test
# description: DDL against a catalog loaded by catalog_contents. Every DDL
#              invalidates the touched set and drops that kind's not-yet-taken
#              snapshot seed, so the set reloads through the per-schema RPC
#              (which sees the change) instead of the stale snapshot; the next
#              transaction's revalidation (catalog_contents with the held etag)
#              gets the changed catalog in full and reloads from it.
#              Regression: before seeds were discarded on invalidation, a view
#              created inside a transaction after the snapshot was taken (but
#              before views were first loaded) was missing from duckdb_views().
#              Fixture: vgi-python vgi/_test_fixtures/catalog_contents.py
#              (contents_reval: a DDL-capable in-memory catalog, private per
#              ATTACH, that advertises supports_catalog_contents and revalidates
#              with an etag bumped by every DDL).
#              Gated on VGI_CATALOG_CONTENTS_WORKER (vgi-python only);
#              catalog_contents_conformance.test is the every-SDK check.
# group: [vgi_integration_catalog]

require-env VGI_CATALOG_CONTENTS_WORKER

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
CREATE MACRO rpc_count(m) AS (
    SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI'
      AND message LIKE '%catalog.rpc%'
      AND message LIKE '%method=' || m || ',%');

statement ok
ATTACH 'contents_reval' AS mem (TYPE vgi, LOCATION '${VGI_CATALOG_CONTENTS_WORKER}');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'mem';
----
0

query I
SELECT rpc_count('catalog_contents');
----
1

query I
SELECT rpc_count('catalog_schemas');
----
0

# ============================================================================
# Autocommit DDL: each statement changes the worker's etag, so the next
# transaction's revalidation returns the full catalog and the cache reloads
# from it.
# ============================================================================

statement ok
CREATE TABLE mem.main.t1 (a INTEGER, b VARCHAR);

statement ok
CREATE VIEW mem.main.v1 AS SELECT 1 AS x;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'mem' ORDER BY ALL;
----
t1

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v1

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'mem' AND table_name = 't1' ORDER BY column_index;
----
a	INTEGER
b	VARCHAR

query I
SELECT rpc_count('catalog_contents') >= 1;
----
true

query I
SELECT rpc_count('catalog_schemas');
----
0

# ============================================================================
# DDL inside a transaction, after the snapshot was taken but before the
# touched kind was first loaded: the stale seed must not be used.
# ============================================================================

statement ok
BEGIN;

# Loads the schema set from a fresh catalog_contents (v1 changed the etag)
# and takes only the table seed; the view seed is still untaken.
query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'mem' ORDER BY ALL;
----
t1

statement ok
CREATE VIEW mem.main.v2 AS SELECT 2 AS x;

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v1
v2

query I
SELECT * FROM mem.main.v2;
----
2

statement ok
COMMIT;

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v1
v2

# Same for tables: CREATE TABLE before the table seed was taken.
statement ok
CREATE VIEW mem.main.v3 AS SELECT 3 AS x;

statement ok
BEGIN;

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v1
v2
v3

statement ok
CREATE TABLE mem.main.t2 (c DOUBLE);

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'mem' ORDER BY ALL;
----
t1
t2

statement ok
COMMIT;

# DROP inside a transaction is not resurrected from the snapshot.
statement ok
CREATE VIEW mem.main.v4 AS SELECT 4 AS x;

statement ok
BEGIN;

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'mem';
----
2

statement ok
DROP VIEW mem.main.v1;

statement ok
DROP TABLE mem.main.t1;

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v2
v3
v4

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'mem' ORDER BY ALL;
----
t2

statement ok
COMMIT;

# ============================================================================
# vgi_clear_cache(): a fresh catalog_contents reflects every change.
# ============================================================================

statement ok
CALL vgi_clear_cache();

statement ok
CALL truncate_duckdb_logs();

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'mem' ORDER BY ALL;
----
t2

query I
SELECT view_name FROM duckdb_views() WHERE database_name = 'mem' ORDER BY ALL;
----
v2
v3
v4

query I
SELECT rpc_count('catalog_contents');
----
1

query I
SELECT rpc_count('catalog_schemas') + rpc_count('catalog_schema_contents_tables') + rpc_count('catalog_schema_contents_views');
----
0

statement ok
DETACH mem;
