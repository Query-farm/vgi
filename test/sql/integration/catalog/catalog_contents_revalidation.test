# name: test/sql/integration/catalog/catalog_contents_revalidation.test
# description: Conditional revalidation (docs/catalog_contents.md, "Caching and
#              revalidation"). A non-frozen catalog whose catalog_contents
#              snapshot carried an etag is checked at transaction start with
#              catalog_contents(if_none_match = etag) instead of the
#              catalog_version poll: one RPC per transaction; not_modified keeps
#              every cache; a full answer (after DDL) replaces the snapshot with
#              no second call. Covered for a cheap catalog-provided etag
#              (contents_reval, "gen-<version>") and the framework's opt-in
#              content hash (contents_hash). vgi_catalog_contents = false
#              restores the catalog_version poll.
#              Fixtures: vgi-python vgi/_test_fixtures/catalog_contents.py,
#              private per ATTACH. Every SDK's test worker serves them.
# group: [vgi_integration_catalog]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
CREATE MACRO rpc_count(m) AS (
    SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI'
      AND message LIKE '%catalog.rpc%'
      AND message LIKE '%method=' || m || ',%');

# Listing RPCs only: binding a view name first probes the (loaded, empty)
# table set, which asks catalog_table_get on a miss — unrelated to
# revalidation, so per-name *_get calls are not counted here.
statement ok
CREATE MACRO per_schema_rpc_count() AS (
    SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI'
      AND message LIKE '%catalog.rpc%'
      AND (message LIKE '%method=catalog_schemas,%' OR message LIKE '%method=catalog_schema_contents_%'));

statement ok
CREATE MACRO revalidations(a) AS (
    SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI'
      AND message LIKE '%catalog.invalidate,%' AND message LIKE '%via=catalog_contents%'
      AND message LIKE '%action=' || a || '%');

statement ok
CREATE MACRO decodes() AS (
    SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI' AND message LIKE '%catalog.seed_decode%');

# ============================================================================
# Cheap etag (contents_reval)
# ============================================================================

statement ok
ATTACH 'contents_reval' AS rv (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE VIEW rv.main.v AS SELECT 7 AS x;

statement ok
CALL truncate_duckdb_logs();

# The CREATE VIEW changed the etag: the transaction-start revalidation gets the
# full catalog and the reload is served from it (one catalog_contents, no
# catalog_version, no per-schema RPCs).
query I
SELECT x FROM rv.main.v;
----
7

query I
SELECT revalidations('clear_modified');
----
1

query I
SELECT rpc_count('catalog_contents');
----
1

query I
SELECT rpc_count('catalog_version') + per_schema_rpc_count();
----
0

query I
SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI'
  AND message LIKE '%catalog.contents,%' AND message LIKE '%outcome=loaded%' AND message LIKE '%source=revalidation%';
----
1

# Unchanged catalog: each transaction is one catalog_contents(if_none_match)
# answered not_modified; every cache is kept (no decode, no other RPC).
statement ok
CALL truncate_duckdb_logs();

query I
SELECT x FROM rv.main.v;
----
7

query I
SELECT x + 1 FROM rv.main.v;
----
8

query I
SELECT COUNT(*) FROM duckdb_views() WHERE database_name = 'rv' AND view_name = 'v';
----
1

query I
SELECT rpc_count('catalog_contents');
----
2

query I
SELECT revalidations('not_modified');
----
2

query I
SELECT rpc_count('catalog_version') + per_schema_rpc_count() + decodes();
----
0

# An explicit transaction is checked once, at its start.
statement ok
CALL truncate_duckdb_logs();

statement ok
BEGIN;

query I
SELECT x FROM rv.main.v;
----
7

query I
SELECT x FROM rv.main.v;
----
7

statement ok
COMMIT;

query I
SELECT rpc_count('catalog_contents');
----
1

# DDL from this session: the next transaction gets the new catalog in full.
statement ok
CREATE VIEW rv.main.w AS SELECT 8 AS y;

statement ok
CALL truncate_duckdb_logs();

query II
SELECT x, y FROM rv.main.v, rv.main.w;
----
7	8

query I
SELECT revalidations('clear_modified');
----
1

query I
SELECT rpc_count('catalog_contents');
----
1

# A conditional call with the current etag is not_modified; any other etag
# gets the full contents.
# The etag is the catalog's own validator.
query I
SELECT etag LIKE 'gen-%' AND NOT not_modified FROM vgi_catalog_contents('rv');
----
true

statement ok
SET VARIABLE rv_etag = (SELECT etag FROM vgi_catalog_contents('rv'));

query III
SELECT not_modified, len(schemas), etag = getvariable('rv_etag')
FROM vgi_catalog_contents('rv', if_none_match := getvariable('rv_etag'));
----
true	0	true

query II
SELECT not_modified, schemas FROM vgi_catalog_contents('rv', if_none_match := 'gen-not-current');
----
false	[main]

# vgi_catalog_contents = false: never call catalog_contents — the
# transaction-start check is the catalog_version poll again.
statement ok
SET vgi_catalog_contents = false;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT x FROM rv.main.v;
----
7

query I
SELECT rpc_count('catalog_contents');
----
0

query I
SELECT rpc_count('catalog_version');
----
1

statement ok
RESET vgi_catalog_contents;

statement ok
DETACH rv;

# ============================================================================
# Content-hash etag (contents_hash: catalog_contents_etag = "content-hash")
# ============================================================================

statement ok
ATTACH 'contents_hash' AS hs (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE VIEW hs.main.v AS SELECT 9 AS x;

# The framework's etag: hex SHA-256 of the serialized contents.
query I
SELECT regexp_full_match(etag, '[0-9a-f]{64}') FROM vgi_catalog_contents('hs');
----
true

statement ok
SET VARIABLE hs_etag = (SELECT etag FROM vgi_catalog_contents('hs'));

query II
SELECT not_modified, len(schemas) FROM vgi_catalog_contents('hs', if_none_match := getvariable('hs_etag'));
----
true	0

statement ok
CALL truncate_duckdb_logs();

# First statement after the DDL: full answer, reload from it.
query I
SELECT x FROM hs.main.v;
----
9

query I
SELECT revalidations('clear_modified');
----
1

statement ok
CALL truncate_duckdb_logs();

# Unchanged contents hash to the same etag: not_modified, caches kept.
query I
SELECT x FROM hs.main.v;
----
9

query I
SELECT x FROM hs.main.v;
----
9

query I
SELECT rpc_count('catalog_contents');
----
2

query I
SELECT revalidations('not_modified');
----
2

query I
SELECT rpc_count('catalog_version') + per_schema_rpc_count() + decodes();
----
0

# A DDL changes the contents and so the hash.
statement ok
CREATE VIEW hs.main.w AS SELECT 10 AS y;

query I
SELECT etag <> getvariable('hs_etag') FROM vgi_catalog_contents('hs');
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT y FROM hs.main.w;
----
10

query I
SELECT revalidations('clear_modified');
----
1

statement ok
DETACH hs;
