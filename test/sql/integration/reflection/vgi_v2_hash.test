# name: test/sql/integration/reflection/vgi_v2_hash.test
# description: Cross-SDK drift guard for the vgi.v3 surface. Every SDK's
#              fixture worker must report, via vgi_rpc.Reflection.v1, the
#              same vgi.v3 protocol_version and protocol_hash as the
#              reference (vgi-python's VgiProtocol). The hash covers every
#              method name and request/response schema, so an SDK that adds,
#              drops, renames or retypes a vgi.v3 method fails here. Uses only
#              reflection, which every worker hosts on every transport.
# group: [vgi_integration_reflection]

require-env VGI_TEST_WORKER

require vgi

require httpfs

# The combined successor uses vgi.v3 / 3.0.0. The expected hash is computed
# from vgi-python's complete VgiProtocol, then pinned in every SDK. Keep the
# version and hash aligned with the generated/native/SDK artifacts. The file
# name is retained for existing integration-suite selection rules.
query II
SELECT protocol_version, protocol_hash
FROM vgi_protocols('${VGI_TEST_WORKER}') WHERE protocol_name = 'vgi.v3';
----
3.0.0	50e9404173bee3262e96b8939eb5c425463336abca2a17916812d68b6e0f6cad
