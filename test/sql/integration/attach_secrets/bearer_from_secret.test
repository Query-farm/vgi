# name: test/sql/integration/attach_secrets/bearer_from_secret.test
# description: a vgi_attach secret's BEARER_TOKEN authenticates discovery and catalog_attach
# group: [vgi_integration_attach_secrets]

# Gated first on the same variable as the rest of this directory, so lanes
# without the attach-options fixtures skip it for an already-allowed reason.
require-env VGI_ATTACH_OPTIONS_WORKER

require-env VGI_ATTACH_OPTIONS_BEARER_WORKER

require-env VGI_ATTACH_OPTIONS_BEARER_TOKEN

require vgi

require httpfs

# Expected errors say "(HTTP 401)"; keep the runner from skipping on "HTTP"
# (see bearer_auth/bearer_token.test).
set ignore_error_messages Unable to connect

# Without credentials the worker refuses discovery (options force the RPC).
statement error
ATTACH 'attach_options' AS b (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_BEARER_WORKER}', opt_string 'x');
----
The server requires authentication

# The secret carries the token and an option. The option needs the discovery
# RPC, which must be authenticated with the secret's token to succeed.
statement ok
CREATE SECRET bearer_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_BEARER_WORKER}',
    BEARER_TOKEN '${VGI_ATTACH_OPTIONS_BEARER_TOKEN}',
    OPTIONS MAP {'opt_string': 'via-bearer-secret'}
);

statement ok
ATTACH 'attach_options' AS b (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_BEARER_WORKER}');

query T
SELECT opt_string FROM b.echo_attach_options();
----
via-bearer-secret

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'b'
  AND options::VARCHAR LIKE '%${VGI_ATTACH_OPTIONS_BEARER_TOKEN}%';
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE secret_string LIKE '%${VGI_ATTACH_OPTIONS_BEARER_TOKEN}%';
----
0

statement ok
DETACH b;

# A token-only secret: no options, so no discovery RPC; catalog_attach itself
# is authenticated.
statement ok
CREATE OR REPLACE SECRET bearer_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_BEARER_WORKER}',
    BEARER_TOKEN '${VGI_ATTACH_OPTIONS_BEARER_TOKEN}'
);

statement ok
ATTACH 'attach_options' AS b (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_BEARER_WORKER}');

query I
SELECT count(*) FROM b.echo_attach_options();
----
1

statement ok
DETACH b;

# An explicit bearer_token wins over the secret's.
statement error
ATTACH 'attach_options' AS b (
    TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_BEARER_WORKER}', bearer_token 'explicit-wrong-token'
);
----
bearer token was rejected

# A wrong token in the secret is rejected like an explicit one.
statement ok
CREATE OR REPLACE SECRET bearer_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_BEARER_WORKER}',
    BEARER_TOKEN 'wrong-token-from-secret'
);

statement error
ATTACH 'attach_options' AS b (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_BEARER_WORKER}');
----
bearer token was rejected

statement ok
DROP SECRET bearer_creds;
