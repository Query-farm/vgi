# name: test/sql/integration/attach_secrets/attach_with_secret.test
# description: vgi_attach secrets supply attach options at ATTACH - scope lookup, explicit wins, attach_secret, no leaks
# group: [vgi_integration_attach_secrets]

require-env VGI_ATTACH_OPTIONS_WORKER

require-env VGI_ATTACH_OPTIONS_HOST

require-env VGI_ATTACH_OPTIONS_WORKER_TRUNCATED

require vgi

require httpfs

# ============================================================================
# Baseline: the gated catalog refuses an ATTACH without its required api_key
# ============================================================================

statement error
ATTACH 'attach_options_required' AS gated (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');
----
required option 'api_key'

# ============================================================================
# A scoped secret satisfies the required option; the ATTACH carries none
# ============================================================================

statement ok
CREATE SECRET gated_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_WORKER}',
    OPTIONS MAP {'api_key': 'sk-from-secret-must-not-leak'}
);

statement ok
ATTACH 'attach_options_required' AS gated (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');

# The value is in neither the ATTACH options nor the path DuckDB exposes.
query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'gated'
  AND (options::VARCHAR LIKE '%must-not-leak%' OR path LIKE '%must-not-leak%');
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE secret_string LIKE '%must-not-leak%';
----
0

statement ok
DETACH gated;

# attach_secret '' turns lookup off for this ATTACH.
statement error
ATTACH 'attach_options_required' AS gated (
    TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret ''
);
----
required option 'api_key'

statement ok
DROP SECRET gated_creds;

# ============================================================================
# Boundary rule against a live LOCATION
# ============================================================================

# The host alone matches across the ':' before the port.
statement ok
CREATE SECRET host_creds (TYPE vgi_attach, SCOPE '${VGI_ATTACH_OPTIONS_HOST}', OPTIONS MAP {'api_key': 'k'});

statement ok
ATTACH 'attach_options_required' AS gated (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');

statement ok
DETACH gated;

statement ok
DROP SECRET host_creds;

# The URL cut one digit short of the port is a prefix, not a boundary match.
statement ok
CREATE SECRET short_creds (TYPE vgi_attach, SCOPE '${VGI_ATTACH_OPTIONS_WORKER_TRUNCATED}', OPTIONS MAP {'api_key': 'k'});

statement error
ATTACH 'attach_options_required' AS gated (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');
----
required option 'api_key'

statement ok
DROP SECRET short_creds;

# An unscoped secret is never used by lookup.
statement ok
CREATE SECRET unscoped_creds (TYPE vgi_attach, OPTIONS MAP {'api_key': 'k'});

statement error
ATTACH 'attach_options_required' AS gated (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');
----
required option 'api_key'

# ...but naming it with attach_secret uses it: scope isn't checked for a named secret.
statement ok
ATTACH 'attach_options_required' AS gated (
    TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'unscoped_creds'
);

statement ok
DETACH gated;

# attach_secret by name also works for a secret scoped elsewhere.
statement ok
CREATE SECRET elsewhere_creds (TYPE vgi_attach, SCOPE 'https://elsewhere.example.com', OPTIONS MAP {'api_key': 'k'});

statement ok
ATTACH 'attach_options_required' AS gated (
    TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'elsewhere_creds'
);

statement ok
DETACH gated;

statement ok
DROP SECRET unscoped_creds;

statement ok
DROP SECRET elsewhere_creds;

# ============================================================================
# Values reach the worker, cast by the declared spec; explicit wins
# ============================================================================

# opt_int32 arrives as VARCHAR in OPTIONS and is cast to the declared INTEGER;
# not_declared is ignored (logged by name only), not an "Unknown ATTACH option".
statement ok
CREATE SECRET echo_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_WORKER}',
    OPTIONS MAP {'opt_string': 'from-secret', 'opt_int32': '99', 'not_declared': 'zzz'}
);

statement ok
ATTACH 'attach_options' AS ao (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');

query TI
SELECT opt_string, opt_int32 FROM ao.echo_attach_options();
----
from-secret	99

# Secret-sourced values never appear in duckdb_databases(), declared secret or not.
query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'ao' AND options::VARCHAR LIKE '%from-secret%';
----
0

statement ok
DETACH ao;

# An explicit option overrides the secret's; the rest still come from it.
statement ok
ATTACH 'attach_options' AS ao (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', opt_string 'explicit');

query TI
SELECT opt_string, opt_int32 FROM ao.echo_attach_options();
----
explicit	99

statement ok
DETACH ao;

# The connection-string form is explicit too.
statement ok
ATTACH 'attach_options?location=${VGI_ATTACH_OPTIONS_WORKER}&opt_string=from-path' AS ao (TYPE vgi);

query TI
SELECT opt_string, opt_int32 FROM ao.echo_attach_options();
----
from-path	99

statement ok
DETACH ao;

# A secret value that can't be cast to the declared type fails without quoting it.
statement ok
CREATE OR REPLACE SECRET echo_creds (
    TYPE vgi_attach,
    SCOPE '${VGI_ATTACH_OPTIONS_WORKER}',
    OPTIONS MAP {'opt_int32': 'not-a-number-must-not-leak'}
);

statement error
ATTACH 'attach_options' AS ao (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}');
----
<REGEX>:^Binder Error: Cannot cast ATTACH option 'opt_int32' from the vgi_attach secret to declared type INTEGER\s*$

statement ok
DROP SECRET echo_creds;

# attach_secret itself is not forwarded to the worker as an attach option.
statement ok
CREATE SECRET named_creds (TYPE vgi_attach, OPTIONS MAP {'opt_string': 'named'});

statement ok
ATTACH 'attach_options' AS ao (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'named_creds');

query T
SELECT opt_string FROM ao.echo_attach_options();
----
named

statement ok
DETACH ao;

statement ok
DROP SECRET named_creds;
