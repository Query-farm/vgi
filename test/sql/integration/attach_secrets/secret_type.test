# name: test/sql/integration/attach_secrets/secret_type.test
# description: the vgi_attach secret type - registration, redaction, scope boundary rule, attach_secret errors
# group: [vgi_integration_attach_secrets]

require-env VGI_ATTACH_OPTIONS_WORKER

require vgi

require httpfs

# ============================================================================
# Registered at LOAD, before any ATTACH
# ============================================================================

query I
SELECT count(*) FROM duckdb_secret_types() WHERE type = 'vgi_attach';
----
1

statement ok
CREATE SECRET host_creds (
    TYPE vgi_attach,
    SCOPE 'https://host',
    BEARER_TOKEN 'bt-must-not-leak',
    OPTIONS MAP {'api_key': 'sk-must-not-leak', 'region': 'eu-west-1'}
);

# Every key is redacted in duckdb_secrets().
query I
SELECT count(*) FROM duckdb_secrets()
WHERE secret_string LIKE '%must-not-leak%' OR secret_string LIKE '%eu-west-1%';
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'host_creds' AND type = 'vgi_attach';
----
1

# ============================================================================
# Boundary rule: the match must end at a URL boundary
# ============================================================================

query T
SELECT name FROM vgi_which_attach_secret('https://host');
----
host_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host/');
----
host_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host/vgi');
----
host_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host:443');
----
host_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host?x');
----
host_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host#frag');
----
host_creds

# DuckDB's own prefix match would hand these the secret.
query I
SELECT count(*) FROM vgi_which_attach_secret('https://host.evil.net');
----
0

query I
SELECT count(*) FROM vgi_which_attach_secret('https://hostx');
----
0

query I
SELECT count(*) FROM which_secret('https://host.evil.net', 'vgi_attach');
----
1

# The longest boundary-respecting scope wins; a longer one that fails the
# boundary does not shadow a shorter one that passes.
statement ok
CREATE SECRET host_api_creds (TYPE vgi_attach, SCOPE 'https://host/api', OPTIONS MAP {'api_key': 'k2'});

query T
SELECT name FROM vgi_which_attach_secret('https://host/api/v1');
----
host_api_creds

query T
SELECT name FROM vgi_which_attach_secret('https://host/apix');
----
host_creds

# A scope ending in '/' is itself a boundary.
statement ok
CREATE SECRET slash_creds (TYPE vgi_attach, SCOPE 'https://other/', OPTIONS MAP {'api_key': 'k3'});

query T
SELECT name FROM vgi_which_attach_secret('https://other/anything');
----
slash_creds

# ============================================================================
# An unscoped vgi_attach secret never matches by lookup
# ============================================================================

statement ok
CREATE SECRET everywhere (TYPE vgi_attach, OPTIONS MAP {'api_key': 'unscoped'});

query I
SELECT count(*) FROM vgi_which_attach_secret('https://unrelated.example.com');
----
0

query I
SELECT count(*) FROM vgi_which_attach_secret('${VGI_ATTACH_OPTIONS_WORKER}');
----
0

# ============================================================================
# CREATE SECRET validation
# ============================================================================

# Worker options go in OPTIONS: DuckDB only accepts declared parameters.
statement error
CREATE SECRET bad (TYPE vgi_attach, SCOPE 'https://x', api_key 'k');
----
Unknown parameter 'api_key'

statement error
CREATE SECRET bad (TYPE vgi_attach, SCOPE 'https://x', OPTIONS MAP {'bearer_token': 'k'});
----
must not contain 'bearer_token'

statement error
CREATE SECRET bad (TYPE vgi_attach, SCOPE 'https://x', BEARER_TOKEN 'a', OAUTH_REFRESH_TOKEN 'b');
----
cannot hold both BEARER_TOKEN and OAUTH_REFRESH_TOKEN

# ============================================================================
# attach_secret: by name, wrong name, wrong type
# ============================================================================

statement error
ATTACH 'attach_options' AS x (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'no_such_secret');
----
no secret named 'no_such_secret'

statement ok
CREATE SECRET an_iroh_identity (TYPE iroh, SCOPE 'iroh://nowhere', SECRET_KEY 'not-a-vgi-attach-secret');

statement error
ATTACH 'attach_options' AS x (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'an_iroh_identity');
----
is of type 'iroh', not 'vgi_attach'

# The policy gate runs first: a refused LOCATION never resolves a secret, so
# the error is the policy's, not the missing secret's.
statement ok
DROP SECRET host_creds;

statement ok
DROP SECRET host_api_creds;

statement ok
DROP SECRET slash_creds;

statement ok
DROP SECRET everywhere;

statement ok
DROP SECRET an_iroh_identity;

# The policy gate runs first: a refused LOCATION never resolves a secret, so
# the error is the policy's, not the missing secret's. (Narrow-only, so last.)
statement ok
SET vgi_allowed_transports = 'subprocess';

statement error
ATTACH 'attach_options' AS x (TYPE vgi, LOCATION '${VGI_ATTACH_OPTIONS_WORKER}', attach_secret 'no_such_secret');
----
is not permitted by vgi_allowed_transports
