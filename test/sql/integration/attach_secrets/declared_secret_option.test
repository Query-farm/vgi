# name: test/sql/integration/attach_secrets/declared_secret_option.test
# description: an attach option the worker declares `secret` is advertised and redacted when given explicitly
# group: [vgi_integration_attach_secrets]

require-env VGI_ATTACH_OPTIONS_WORKER

# Set by run_http_attach_options_integration.sh for a worker that declares
# api_key `secret` (vgi-python >= 0.38). A worker that predates the column
# reads as secret = false everywhere, which secret_type.test and
# attach_with_secret.test cover.
require-env VGI_ATTACH_OPTIONS_DECLARES_SECRET

require vgi

require httpfs

query TTT
SELECT opt.name, opt.required, opt.secret
FROM (
    SELECT UNNEST(attach_options) AS opt
    FROM vgi_catalogs('${VGI_ATTACH_OPTIONS_WORKER}')
    WHERE catalog = 'attach_options_required'
)
ORDER BY opt.name;
----
api_key	true	true
region	false	false

query T
SELECT DISTINCT opt.secret
FROM (
    SELECT UNNEST(attach_options) AS opt
    FROM vgi_catalogs('${VGI_ATTACH_OPTIONS_WORKER}')
    WHERE catalog = 'attach_options'
);
----
false

# Given explicitly, a declared-secret option is redacted from duckdb_databases();
# an ordinary one is not.
statement ok
ATTACH 'attach_options_required' AS gated (
    TYPE vgi,
    LOCATION '${VGI_ATTACH_OPTIONS_WORKER}',
    api_key 'sk-explicit-must-not-leak',
    region 'eu-west-1'
);

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'gated' AND options::VARCHAR LIKE '%must-not-leak%';
----
0

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'gated' AND options::VARCHAR LIKE '%<redacted>%' AND options::VARCHAR LIKE '%eu-west-1%';
----
1

statement ok
DETACH gated;

# In the connection-string form, the whole query is redacted from the path.
statement ok
ATTACH 'attach_options_required?location=${VGI_ATTACH_OPTIONS_WORKER}&api_key=sk-path-must-not-leak' AS gated (TYPE vgi);

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'gated' AND (path LIKE '%must-not-leak%' OR options::VARCHAR LIKE '%must-not-leak%');
----
0

statement ok
DETACH gated;
