# name: test/sql/integration/aggregate/const_param.test
# description: ConstParam (constant parameter folding) on aggregate functions
# group: [vgi_integration_aggregate]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# ============================================================================
# Basic ConstParam — example.main.vgi_percentile(value, percentile)
# percentile is constant-folded at bind time
# ============================================================================

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.0) FROM range(10) t(i);
----
0.0

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.5) FROM range(10) t(i);
----
5.0

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.9) FROM range(10) t(i);
----
9.0

# ============================================================================
# ConstParam with GROUP BY
# ============================================================================

statement ok
SET threads=1;

query IR
SELECT i % 3 AS grp, example.main.vgi_percentile(i::DOUBLE, 0.5)
FROM range(9) t(i)
GROUP BY grp ORDER BY grp;
----
0	3.0
1	4.0
2	5.0

# ============================================================================
# ConstParam with expression (const folding of non-literal expression)
# ============================================================================

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.25 + 0.25) FROM range(10) t(i);
----
5.0

# ============================================================================
# ConstParam with HAVING
# ============================================================================

query IR
SELECT i % 3 AS grp, example.main.vgi_percentile(i::DOUBLE, 0.5)
FROM range(9) t(i)
GROUP BY grp
HAVING example.main.vgi_percentile(i::DOUBLE, 0.5) > 3.5
ORDER BY grp;
----
1	4.0
2	5.0

# ============================================================================
# Phase-aware ConstParam (phase="finalize")
# vgi_percentile declares percentile with phase="finalize" — the const value
# is NOT passed to update() (uses default), only available in finalize via
# params.args. Different percentile values produce different results.
# ============================================================================

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.0) FROM range(10) t(i);
----
0.0

query R
SELECT example.main.vgi_percentile(i::DOUBLE, 0.9) FROM range(10) t(i);
----
9.0

# Grouped with phase="finalize" ConstParam
query IR
SELECT i % 2 AS grp, example.main.vgi_percentile(i::DOUBLE, 0.0)
FROM range(10) t(i)
GROUP BY grp ORDER BY grp;
----
0	0.0
1	1.0

# ============================================================================
# Regression: vgi_percentile previously accepted any constant for `percentile`
# and crashed late inside finalize() with raw TypeError/ValueError when the
# value was NULL, NaN, or out of [0, 1]. The fixture now validates the
# constant up-front and raises a clear, descriptive error.
# ============================================================================

statement error
SELECT example.main.vgi_percentile(i::DOUBLE, NULL) FROM range(10) t(i);
----
percentile must not be NULL

statement error
SELECT example.main.vgi_percentile(i::DOUBLE, 'nan'::DOUBLE) FROM range(10) t(i);
----
percentile must be a finite number

statement error
SELECT example.main.vgi_percentile(i::DOUBLE, 'inf'::DOUBLE) FROM range(10) t(i);
----
percentile must be a finite number

statement error
SELECT example.main.vgi_percentile(i::DOUBLE, -0.1) FROM range(10) t(i);
----
percentile must be in [0, 1]

statement error
SELECT example.main.vgi_percentile(i::DOUBLE, 1.5) FROM range(10) t(i);
----
percentile must be in [0, 1]

# ============================================================================
# Cleanup
# ============================================================================

# ============================================================================
# Plan copy: const params are erased at bind, so a copied plan must not be
# re-resolved by the erased types (Serialization Error). CTE inlining copies it.
# ============================================================================

query IRR
WITH c AS NOT MATERIALIZED (SELECT i % 2 g, example.main.vgi_percentile(i::DOUBLE, 0.5) p FROM range(10) t(i) GROUP BY g)
SELECT c1.g, c1.p, c2.p FROM c c1 JOIN c c2 USING (g) ORDER BY 1;
----
0	4.0	4.0
1	5.0	5.0

query IRR
WITH c AS (SELECT i % 2 g, example.main.vgi_percentile(i::DOUBLE, 0.5) p FROM range(10) t(i) GROUP BY g)
SELECT c1.g, c1.p, c2.p FROM c c1 JOIN c c2 USING (g) ORDER BY 1 LIMIT 2;
----
0	4.0	4.0
1	5.0	5.0

# Two different constants in one SELECT stay distinct (no CSE merge).
query RR
SELECT example.main.vgi_percentile(i::DOUBLE, 0.2), example.main.vgi_percentile(i::DOUBLE, 0.8) FROM range(10) t(i);
----
2.0	8.0


statement ok
DETACH example;
