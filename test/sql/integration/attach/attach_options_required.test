# name: test/sql/integration/attach/attach_options_required.test
# description: attach options declared `required` are advertised at discovery and enforced at ATTACH
# group: [vgi_integration_attach]

# Gated separately from attach_options_echo.test: the gated catalog is a
# Python-fixture-only catalog for now, and the shared file runs against every
# language's attach-options worker.
require-env VGI_ATTACH_OPTIONS_REQUIRED_WORKER

require vgi

require httpfs

# ============================================================================
# Required options: declared at discovery, enforced at ATTACH
# ============================================================================

# Every option of the main catalog has a default, so none is required.
query T
SELECT DISTINCT opt.required
FROM (
    SELECT UNNEST(attach_options) AS opt
    FROM vgi_catalogs('${VGI_ATTACH_OPTIONS_REQUIRED_WORKER}')
    WHERE catalog = 'attach_options'
);
----
false

# The gated catalog advertises which option the caller has to supply, so a
# client can say so before attempting the attach.
query TTT
SELECT opt.name, opt.required, opt.default_value
FROM (
    SELECT UNNEST(attach_options) AS opt
    FROM vgi_catalogs('${VGI_ATTACH_OPTIONS_REQUIRED_WORKER}')
    WHERE catalog = 'attach_options_required'
)
ORDER BY opt.name;
----
api_key	true	NULL
region	false	us-east-1

# Omitting it fails the ATTACH outright rather than yielding an empty catalog.
statement error
ATTACH 'attach_options_required' AS gated (
    TYPE vgi,
    LOCATION '${VGI_ATTACH_OPTIONS_REQUIRED_WORKER}'
);
----
required option 'api_key'

# Supplying it attaches normally.
statement ok
ATTACH 'attach_options_required' AS gated (
    TYPE vgi,
    LOCATION '${VGI_ATTACH_OPTIONS_REQUIRED_WORKER}',
    api_key 'secret'
);

statement ok
DETACH gated;
