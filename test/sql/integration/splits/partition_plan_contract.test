# name: test/sql/integration/splits/partition_plan_contract.test
# description: Protocol 3.1 exact split-key validation fails closed
# group: [vgi_integration_splits]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '{VGI_TEST_WORKER}');

# An exact grouping claim requires one key tuple on every split.
statement error
SELECT country, SUM(sales)
FROM example.main.split_partitioned(rows_per_country := 2, key_mode := 'missing')
GROUP BY country;
----
declared an exact key grouping but split 0 has no key_value

# The tuple is exactly one row, not a bounds batch or a set of possible keys.
statement error
SELECT country, SUM(sales)
FROM example.main.split_partitioned(rows_per_country := 2, key_mode := 'two_rows')
GROUP BY country;
----
key_value must contain exactly one row

# Names are advisory for mapping, but Arrow data types must match the declared
# bind schema before DuckDB can expose them as partition values.
statement error
SELECT country, SUM(sales)
FROM example.main.split_partitioned(rows_per_country := 2, key_mode := 'wrong_type')
GROUP BY country;
----
key_value column 'country' has type int64; expected string

statement ok
DETACH example;
