# name: test/sql/integration/splits/poisoned_conn.test
# description: A failed split INIT must not return its connection to the pool
# group: [vgi_integration_splits]

# This is the one whose failure mode is silent cross-QUERY corruption, so it is
# worth being precise about the mechanism it guards.
#
# Greedy claiming reuses one connection across splits: reset it, write split
# N+1's init, drain, repeat. The reset clears the flags that mark a stream as
# in-flight — which is correct, because the previous stream really has ended. But
# if the NEXT init then throws, the connection looks idle while an unanswered
# init request is sitting on the worker's stdin. Returned to the pool, the next
# checkout reads THIS split's init response as its own stream header: a different
# query, silently answered with another query's data.
#
# It is the `pool true` default that makes this reachable, so this test runs
# against the default rather than pinning `pool false`.
#
# Distinct from errors.test, which fails MID-STREAM: there the stream is
# genuinely in flight and the ordinary in-flight gate already refuses to pool it.
# Here the failure lands in the window where that gate reads "idle".

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# Warm the pool, so the failing scan is reusing a connection rather than a fresh
# one — reuse is the situation the reset path exists for.
query I
SELECT count(*) FROM example.main.split_sequence(n := 40, splits := 4);
----
40

# Split 3 refuses to initialize. Enough splits that the reader has already
# drained several on this connection before the failing init.
statement error
SELECT count(*) FROM example.main.split_fail_at(n := 60, splits := 6, fail_at := 3, fail_in_init := true);
----
refuses to initialize

# The load-bearing assertion: the very next query on the same worker path is
# correct. A pooled poisoned connection shows up here as a wrong row count, a
# schema mismatch, or an IPC error — never as a repeat of the message above.
query II
SELECT count(*), sum(n) FROM example.main.split_sequence(n := 200, splits := 7);
----
200	19900

# ...and a differently-shaped query too, since a stale response would be read as
# whatever header the next checkout expected.
query II
SELECT count(*), sum(n) FROM example.main.split_sequence(n := 33, splits := 5);
----
33	528

# Repeat the failure and recover again: one bad init must not depend on the pool
# being cold, or on being the first failure of the session.
statement error
SELECT count(*) FROM example.main.split_fail_at(n := 60, splits := 6, fail_at := 0, fail_in_init := true);
----
refuses to initialize

query II
SELECT count(*), sum(n) FROM example.main.split_sequence(n := 200, splits := 7);
----
200	19900

# Failing on the FIRST split is its own case: the stale-pool retry is narrowed to
# split 0, so this is the one failure the client is allowed to retry — it must
# still surface rather than loop or succeed spuriously.
statement error
SELECT count(*) FROM example.main.split_fail_at(n := 10, splits := 2, fail_at := 0, fail_in_init := true);
----
refuses to initialize

query I
SELECT count(*) FROM example.main.split_sequence(n := 10, splits := 2);
----
10

statement ok
DETACH example;
