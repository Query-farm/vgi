# name: test/sql/integration/splits/cache_interaction.test
# description: The result cache does not learn about splits, and never commits a partial
# group: [vgi_integration_splits]

# VgiResultCacheKey describes the QUERY (identity, filters, projection,
# catalog_version); splits are how the rows were produced. So a split scan and a
# non-split scan of the same query must share a key and be interchangeable —
# neither should be able to serve the other a different row set.
#
# The never-partial half is the one that fails silently. "eos == launched" only
# proves every reader that STARTED also finished; on the split path a reader
# destroyed mid-split consumed a claim without reading it, and the surviving
# readers' completions would paper over the hole — committing a partial result as
# though it were whole. Hence the extra gate on drained-vs-planned splits.

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CALL enable_logging(level := 'debug');

# hits/inserts are PROCESS-GLOBAL CUMULATIVE counters, and vgi_result_cache_flush()
# clears entries without resetting them — so an absolute assertion on either is
# really an assertion about every file that ran earlier in the same process. The
# HTTP runner puts the whole suite in one process, so baseline them here and
# assert on the DELTA below.
statement ok
CREATE TEMP TABLE cache_baseline AS SELECT hits, inserts FROM vgi_result_cache_stats();

# Repeat an identical split scan; the answer must not drift.
query II
SELECT count(*), sum(n) FROM example.main.split_cacheable(n := 300, splits := 9);
----
300	44850

query II
SELECT count(*), sum(n) FROM example.main.split_cacheable(n := 300, splits := 9);
----
300	44850

# Whatever the cache did, it must never have committed a SUBSET. If a partial had
# been stored and served, this count would drop below 300 on a later read.
query II
SELECT count(*), sum(n) FROM example.main.split_cacheable(n := 300, splits := 9);
----
300	44850

# The entry really exists — without this the assertions above are satisfied by a
# cache that never stored anything, which is what they were before: the file drove
# a fixture advertising no cacheability at all, so "it must never have committed a
# SUBSET" was true of a cache with nothing in it.
query I
SELECT entries > 0 FROM vgi_result_cache_stats();
----
true

# KNOWN GAP — a split scan POPULATES the cache but never SERVES from it, so an
# identical repeat re-runs the worker and inserts again (entries stays 1, inserts
# climbs). The serve path is gated on `!supports_splits`, which is broader than
# the invariant requires: only REVALIDATION needs refusing on the split path
# (the stored entry carries no per-split validators), while an ordinary hit
# short-circuits the worker before splits are ever planned.
#
# Asserted rather than left to be rediscovered. Answers are correct either way —
# this costs a re-scan, not a wrong result.
query I
SELECT (SELECT inserts FROM vgi_result_cache_stats())
     - (SELECT inserts FROM cache_baseline) > 1;
----
true

query I
SELECT (SELECT hits FROM vgi_result_cache_stats())
     - (SELECT hits FROM cache_baseline);
----
0

# The plan RPC is observable, so a split scan is provably taking the split path
# rather than silently falling back.
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type='VGI' AND message LIKE '%scan.plan%';
----
true
