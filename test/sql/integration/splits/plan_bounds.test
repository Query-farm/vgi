# name: test/sql/integration/splits/plan_bounds.test
# description: A worker that paginates forever hits the page cap and throws, never truncates
# group: [vgi_integration_splits]

# Split enumeration is paginated: a plan response may carry a cursor, and the
# client follows it until the worker returns none. A worker that never returns
# none — by accident as easily as on purpose — would otherwise hang the client,
# and the tempting mitigation is the wrong one.
#
# Stopping early and scanning what was collected would turn a hang into a SILENT
# SUBSET: a correct-looking answer missing rows, with no error, which is the
# failure class this whole change exists to prevent. So the cap must throw, and
# the message must name what was hit — an operator diagnosing this needs to know
# it was the client's bound, not the worker's data.

require-env VGI_TEST_WORKER

require vgi

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# The fixture hands back one split and a fresh cursor every page, forever.
statement error
SELECT count(*) FROM example.main.split_endless_cursor(n := 10, splits := 1);
----
page cap

# The error names the function, so an operator can tell WHICH scan misbehaved
# when several are in flight.
statement error
SELECT count(*) FROM example.main.split_endless_cursor(n := 10, splits := 1);
----
split_endless_cursor

# It refuses rather than serving a partial enumeration — stated separately from
# the message check because this is the property that matters.
statement error
SELECT count(*) FROM example.main.split_endless_cursor(n := 10, splits := 1);
----
refusing to scan a partial split enumeration

# The catalog survives it: hitting the cap is a bounded, recoverable failure, not
# a poisoned connection.
query II
SELECT count(*), sum(n) FROM example.main.split_sequence(n := 60, splits := 5);
----
60	1770

statement ok
DETACH example;
