# name: test/sql/integration/http/max_decompressed_bytes.test
# description: vgi_http_max_decompressed_bytes bounds decompressed HTTP response bodies
# group: [vgi_integration_http]
#
# Compressed responses are capped so a tiny body declaring an enormous output
# cannot exhaust host memory. The cap used to be a hardcoded 1 GiB, which made
# it the tightest limit anywhere in the stack: a worker returning a batch
# between 1 GiB and DuckDB's own 4 GiB per-value ceiling failed when
# compression was on and succeeded when it was off -- backwards, since
# compression is worth most exactly on large payloads.
#
# It is now a setting. This test pins the three behaviours that matter without
# moving gigabytes: the default is in force, a tiny cap actually rejects, and
# 0 falls back to the default rather than rejecting everything.

require-env VGI_TEST_WORKER

require-env VGI_HTTP_TRANSPORT

require vgi

require httpfs

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# Default is 1 GiB.
query I
SELECT current_setting('vgi_http_max_decompressed_bytes');
----
1073741824

# A normal query is unaffected by the default.
query I
SELECT count(*) FROM ex.make_series(100);
----
100

# Raising the cap is accepted and changes nothing for ordinary payloads.
statement ok
SET vgi_http_max_decompressed_bytes = 4294967296;

query I
SELECT count(*) FROM ex.make_series(100);
----
100

# A cap below the response size rejects rather than silently truncating.
# 64 bytes is under any real decompressed VGI response body.
statement ok
SET vgi_http_max_decompressed_bytes = 64;

statement error
SELECT count(*) FROM ex.make_series(100);
----
decompression rejected

# 0 means "unset" -- restore the default rather than rejecting every body,
# so a mistaken 0 doesn't look like wire corruption.
statement ok
SET vgi_http_max_decompressed_bytes = 0;

query I
SELECT count(*) FROM ex.make_series(100);
----
100
