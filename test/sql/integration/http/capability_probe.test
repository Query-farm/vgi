# name: test/sql/integration/http/capability_probe.test
# description: discovered ServerCapabilities are refreshed without repeated health probes
# group: [vgi_integration_http]
#
# Capability headers ride every server response (stamped by
# _CapabilitiesMiddleware), so the C++ client learns ServerCapabilities from
# the /init and /exchange responses it already receives. Discovery is
# mandatory before the first application call; once ATTACH has established a
# positive snapshot, a healthy workload must not repeat that probe.

require-env VGI_TEST_WORKER

require-env VGI_HTTP_TRANSPORT

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
ATTACH 'example' AS ex (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CALL truncate_duckdb_logs();

# Scalar function → exchange mode. Pre-harvest, the first exchange used to pay
# a HEAD /health round trip per connection right here.
query I
SELECT ex.double(21);
----
42

# Table function → producer mode (init + continuations).
query I
SELECT count(*) > 0 FROM ex.data.cacheable_numbers;
----
true

# The load-bearing assertion: post-ATTACH capabilities came from harvested
# response headers; no redundant probe fired.
query I
SELECT COUNT(*) FROM duckdb_logs() WHERE type = 'VGI' AND message LIKE '%http.capability_probe%';
----
0

statement ok
DETACH ex;
