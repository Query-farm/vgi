# name: test/sql/integration/writable_tx/merge_returning.test
# description: MERGE INTO ... RETURNING: merge_action and the written rows of
#              INSERT, UPDATE and DELETE actions, on both attaches.
#              Fixture contract: docs/writable_tx_fixtures.md.
# group: [vgi_integration_writable_tx]

require-env VGI_WRITABLE_TX_FIXTURES

require-env VGI_WRITABLE_TX_WORKER

require vgi

# For an http:// VGI_WRITABLE_TX_WORKER.
require httpfs

statement ok
ATTACH 'txfix' AS t (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-merge-returning');

statement ok
ATTACH 'txfix' AS ttx (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-merge-returning', transactional true);

query T
SELECT ok FROM t.main.reset();
----
true

query TITI rowsort
MERGE INTO t.main.items AS tgt USING (VALUES (1, 'A', 11), (2, NULL, NULL), (4, 'd', 40)) s(id, name, qty) ON tgt.id = s.id
WHEN MATCHED AND s.name IS NULL THEN DELETE
WHEN MATCHED THEN UPDATE SET name = s.name, qty = s.qty
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.name, s.qty)
RETURNING merge_action, *;
----
DELETE	2	b	20
INSERT	4	d	40
UPDATE	1	A	11

query ITI
SELECT id, name, qty FROM t.main.items ORDER BY id;
----
1	A	11
3	c	30
4	d	40

query TII
MERGE INTO t.main.items AS tgt USING (VALUES (3, 5)) s(id, q) ON tgt.id = s.id
WHEN MATCHED THEN UPDATE SET qty = tgt.qty + s.q
RETURNING merge_action, id, qty * 10;
----
UPDATE	3	350

statement ok
BEGIN;

query TITI rowsort
MERGE INTO ttx.main.items AS tgt USING (VALUES (1, 1), (7, 7)) s(id, q) ON tgt.id = s.id
WHEN MATCHED THEN UPDATE SET qty = s.q
WHEN NOT MATCHED THEN INSERT (id, name) VALUES (s.id, 'g')
RETURNING merge_action, *;
----
INSERT	7	g	0
UPDATE	1	A	1

statement ok
COMMIT;

query ITI
SELECT id, name, qty FROM t.main.items ORDER BY id;
----
1	A	1
3	c	35
4	d	40
7	g	0
