# name: test/sql/integration/writable_tx/merge_tx.test
# description: MERGE INTO on a transactional attach: every action's write call
#              is staged under the statement's transaction, with read-your-writes;
#              ROLLBACK and a failed MERGE discard all of it, COMMIT applies it.
#              Fixture contract: docs/writable_tx_fixtures.md.
# group: [vgi_integration_writable_tx]

require-env VGI_WRITABLE_TX_FIXTURES

require-env VGI_WRITABLE_TX_WORKER

require vgi

# For an http:// VGI_WRITABLE_TX_WORKER.
require httpfs

statement ok
ATTACH 'txfix' AS t (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-merge-tx');

statement ok
ATTACH 'txfix' AS ttx (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-merge-tx', transactional true);

query T
SELECT ok FROM t.main.reset();
----
true

statement ok
BEGIN;

query I
MERGE INTO ttx.main.items AS tgt USING (VALUES (1, 'A', 11), (2, 'x', 1), (4, 'd', 40)) s(id, name, qty) ON tgt.id = s.id
WHEN MATCHED AND s.qty = 1 THEN DELETE
WHEN MATCHED THEN UPDATE SET name = s.name, qty = tgt.qty + s.qty
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.name, s.qty);
----
3

query ITI
SELECT id, name, qty FROM ttx.main.items ORDER BY id;
----
1	A	21
3	c	30
4	d	40

query ITI
SELECT id, name, qty FROM t.main.items ORDER BY id;
----
1	a	10
2	b	20
3	c	30

# A second MERGE in the transaction reads the first one's staged rows.
statement ok
MERGE INTO ttx.main.items AS tgt USING (VALUES (4, 1)) s(id, q) ON tgt.id = s.id
WHEN MATCHED THEN UPDATE SET qty = tgt.qty + s.q;

query I
SELECT qty FROM ttx.main.items WHERE id = 4;
----
41

statement ok
COMMIT;

query ITI
SELECT id, name, qty FROM t.main.items ORDER BY id;
----
1	A	21
3	c	30
4	d	41

# Every call carried the transaction id.
query I
SELECT count(*) FROM t.main.writes() WHERE finalized AND tx_id IS NULL;
----
0

# ============================================================================
# ROLLBACK discards a MERGE
# ============================================================================

statement ok
BEGIN;

statement ok
MERGE INTO ttx.main.items AS tgt USING (VALUES (1), (9)) s(id) ON tgt.id = s.id
WHEN MATCHED THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 'nine', 9);

query I
SELECT list(id ORDER BY id) = [3, 4, 9] FROM ttx.main.items;
----
true

statement ok
ROLLBACK;

query ITI
SELECT id, name, qty FROM ttx.main.items ORDER BY id;
----
1	A	21
3	c	30
4	d	41

# ============================================================================
# A failed MERGE discards everything its actions staged
# ============================================================================

statement error
MERGE INTO ttx.main.items AS tgt USING (VALUES (1, 1), (3, 2), (5, 3)) s(id, v) ON tgt.id = s.id
WHEN MATCHED AND s.v = 2 THEN ERROR 'merge refused'
WHEN MATCHED THEN UPDATE SET qty = 0
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 'e', 50);
----
<REGEX>:.*merge refused.*

query ITI
SELECT id, name, qty FROM t.main.items ORDER BY id;
----
1	A	21
3	c	30
4	d	41

# A refused commit (a staged qty < 0 from a MERGE) discards it too.
statement error
MERGE INTO ttx.main.items AS tgt USING (VALUES (1, -1), (6, -6)) s(id, q) ON tgt.id = s.id
WHEN MATCHED THEN UPDATE SET qty = s.q
WHEN NOT MATCHED THEN INSERT VALUES (s.id, 'f', s.q);
----
<REGEX>:.*txfix: commit refused: qty -1 for id 1.*

query ITI
SELECT id, name, qty FROM ttx.main.items ORDER BY id;
----
1	A	21
3	c	30
4	d	41

# Autocommit MERGE commits by itself.
statement ok
MERGE INTO ttx.main.items AS tgt USING (VALUES (3, 31)) s(id, q) ON tgt.id = s.id
WHEN MATCHED THEN UPDATE SET qty = s.q;

query I
SELECT qty FROM t.main.items WHERE id = 3;
----
31
