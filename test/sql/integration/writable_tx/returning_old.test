# name: test/sql/integration/writable_tx/returning_old.test
# description: Write result mode `changes` is unreachable from SQL today, so
#              this file pins what IS reachable. The extension requests only
#              `count` (plain UPDATE) and `rows` (RETURNING); see
#              BuildWriteOptions in src/storage/vgi_physical_write.cpp. The one
#              SQL form that would need the OLD row image `changes` carries,
#              RETURNING OLD.x, does not bind in this engine at all, for VGI
#              and native tables alike. A table advertising `changes` serves
#              `count` and `rows`. When this file starts failing on the OLD
#              assertions, the engine has grown OLD/NEW RETURNING: wire
#              `changes` through and replace them with real coverage.
#              Fixture contract: docs/writable_tx_fixtures.md.
# group: [vgi_integration_writable_tx]

require-env VGI_WRITABLE_TX_FIXTURES

require-env VGI_WRITABLE_TX_WORKER

require vgi

statement ok
ATTACH 'txfix' AS t (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-returning-old');

statement ok
ATTACH 'txfix' AS ttx (TYPE vgi, LOCATION '${VGI_WRITABLE_TX_WORKER}', token 'tok-returning-old', transactional true);

query T
SELECT ok FROM t.main.reset();
----
true

# The engine refuses OLD in RETURNING before planning (a native table behaves
# the same way: this is not a VGI restriction)...
statement ok
CREATE TABLE native_items (id INTEGER, qty BIGINT);

statement ok
INSERT INTO native_items VALUES (1, 10);

statement error
UPDATE native_items SET qty = 11 RETURNING OLD.qty;
----
<REGEX>:.*Binder Error.*OLD.*

statement error
UPDATE t.main.items SET qty = 11 WHERE id = 1 RETURNING OLD.qty;
----
<REGEX>:.*Binder Error.*OLD.*

statement error
UPDATE ttx.main.items SET qty = 11 WHERE id = 1 RETURNING OLD.qty;
----
<REGEX>:.*Binder Error.*OLD.*

# ...so nothing was changed, and no transaction reached commit with a change.
query II
SELECT id, qty FROM t.main.items ORDER BY id;
----
1	10
2	20
3	30

# The worker advertises update mode `changes` (a maximum); the extension asks
# for `rows` for RETURNING...
query ITI
UPDATE t.main.items SET qty = 11 WHERE id = 1 RETURNING *;
----
1	a	11

query I
UPDATE ttx.main.items SET qty = 12 WHERE id = 1 RETURNING qty;
----
12

# ...and `count` without it.
query I
UPDATE t.main.items SET qty = 13 WHERE id <= 2;
----
2

query II
SELECT id, qty FROM t.main.items ORDER BY id;
----
1	13
2	13
3	30
