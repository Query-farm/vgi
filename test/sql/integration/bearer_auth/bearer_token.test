# name: test/sql/integration/bearer_auth/bearer_token.test
# description: Tests for bearer_token ATTACH option with HTTP transport
# group: [vgi_integration_bearer_auth]

require-env VGI_TEST_WORKER

require-env VGI_TEST_BEARER_TOKEN

require vgi

require httpfs

# Drop "HTTP" from the runner's ignore list, keeping the rest of the default.
# DuckDB defaults ignore_error_messages to {"HTTP", "Unable to connect"} as
# network-flakiness tolerance (sqllogic_test_runner.hpp:76), and it matches a
# bare SUBSTRING. Every assertion in this file expects an error that says
# "(HTTP 401)", so the runner skipped the entire file — silently, reporting it
# as neither pass nor fail. This test has therefore never executed, for ANY
# SDK, which is how a client bug in the 401 challenge path survived: a
# standards-compliant RFC-6750 `WWW-Authenticate: Bearer realm="..."` was
# rejected as "no OAuth resource_metadata" instead of reaching the auth
# handler, and nothing noticed.
set ignore_error_messages Unable to connect

# ============================================================================
# ATTACH with bearer_token succeeds
# ============================================================================

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}', bearer_token '${VGI_TEST_BEARER_TOKEN}');

# ============================================================================
# Basic scalar function works with bearer auth
# ============================================================================

query I
SELECT example.double(21);
----
42

# ============================================================================
# Table function works with bearer auth
# ============================================================================

query I
SELECT count(*) > 0 FROM example.main.projected_data(10);
----
true

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DETACH example;

# ============================================================================
# ATTACH with wrong bearer_token fails
# ============================================================================

statement error
ATTACH 'example' AS example_bad (TYPE vgi, LOCATION '${VGI_TEST_WORKER}', bearer_token 'wrong-token');
----
bearer token was rejected

# ============================================================================
# bearer_token and oauth_refresh_token are mutually exclusive
# ============================================================================

statement error
ATTACH 'example' AS example_both (TYPE vgi, LOCATION '${VGI_TEST_WORKER}', bearer_token 'token', oauth_refresh_token 'token');
----
Cannot specify both bearer_token and oauth_refresh_token

# ============================================================================
# ATTACH without any credentials against a bearer-protected server yields a
# clean diagnostic — not the legacy "VGI OAuth: resource metadata URL must
# use HTTPS:" message that surfaced when the default OAuthCatalogAuth tried
# to feed an empty challenge into the OAuth discovery flow.
# ============================================================================

# The diagnostic arrives at ATTACH, not at the first query: a bearer-protected
# server 401s on catalog_attach itself. This block previously expected ATTACH to
# succeed and the SELECT to fail — an assumption that was never true and never
# checked, because the whole file skipped. Verified against both the Python and
# Java workers, which agree.
statement error
ATTACH 'example' AS example_no_auth (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');
----
The server requires authentication but advertised no OAuth challenge
