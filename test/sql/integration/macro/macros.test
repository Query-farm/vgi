# name: test/sql/integration/macro/macros.test
# description: Tests for VGI macro support (scalar and table macros)
# group: [vgi_integration_macro]

require-env VGI_TEST_WORKER

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# ============================================================================
# Macro inventory: macros should appear in duckdb_functions()
# ============================================================================

# Scalar macros
query IIII rowsort
SELECT database_name, schema_name, function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'example' AND function_type = 'macro';
----
example	main	vgi_clamp	macro
example	main	vgi_multiply	macro

# Table macros
query IIII rowsort
SELECT database_name, schema_name, function_name, function_type
FROM duckdb_functions()
WHERE database_name = 'example' AND function_type = 'table_macro';
----
example	main	vgi_range_table	table_macro

# ============================================================================
# vgi_multiply(x, y) — x * y
# ============================================================================

query I
SELECT example.vgi_multiply(3, 4);
----
12

query I
SELECT example.vgi_multiply(0, 100);
----
0

query I
SELECT example.vgi_multiply(-5, 3);
----
-15

# Works with expressions
query I
SELECT example.vgi_multiply(2 + 3, 4);
----
20

# ============================================================================
# vgi_clamp(val, lo, hi) — GREATEST(lo, LEAST(hi, val))
# Defaults: lo=0, hi=100
# ============================================================================

# All arguments specified
query I
SELECT example.vgi_clamp(50, 0, 100);
----
50

# Value below lo
query I
SELECT example.vgi_clamp(-10, 0, 100);
----
0

# Value above hi
query I
SELECT example.vgi_clamp(200, 0, 100);
----
100

# Using defaults (lo=0, hi=100)
query I
SELECT example.vgi_clamp(50);
----
50

query I
SELECT example.vgi_clamp(-10);
----
0

query I
SELECT example.vgi_clamp(200);
----
100

# Override just one default
query I
SELECT example.vgi_clamp(5, lo := 10);
----
10

query I
SELECT example.vgi_clamp(50, hi := 25);
----
25

# ============================================================================
# vgi_range_table(n) — SELECT * FROM range(n)
# ============================================================================

query I
SELECT COUNT(*) FROM example.vgi_range_table(10);
----
10

query I
SELECT MIN(range) FROM example.vgi_range_table(5);
----
0

query I
SELECT MAX(range) FROM example.vgi_range_table(5);
----
4

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DETACH example;

# Macro dependencies are qualified to the catalog alias chosen by the caller,
# rather than the worker's catalog name or the current search path.
statement ok
ATTACH 'example' AS renamed (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CALL enable_logging(level := 'debug');

statement ok
CALL truncate_duckdb_logs();

query I
SELECT renamed.vgi_multiply(3, 4);
----
12

# The Rust fixture implements vgi_clamp through a scalar subquery over the
# same-schema vgi_range_table macro. Other workers expose the same public
# result directly, keeping this shared corpus portable.
query I
SELECT renamed.vgi_clamp(50);
----
50

# Scalar/aggregate/table function and scalar/table macro inventories are each
# fetched at most once for this schema. Both macro sets share the discovery
# snapshot, and normal function-set loading reuses it too.
query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%catalog.rpc%'
  AND message LIKE '%method=catalog_schema_contents_functions%'
  AND message LIKE '%entity_qualifier=main%';
----
3

query I
SELECT COUNT(*) FROM duckdb_logs()
WHERE type = 'VGI'
  AND message LIKE '%catalog.rpc%'
  AND message LIKE '%method=catalog_schema_contents_macros%'
  AND message LIKE '%entity_qualifier=main%';
----
2

statement ok
DETACH renamed;
