# name: test/sql/integration/secret/secret_types_function.test
# description: vgi_secret_types() surfaces declared secret types, their parameters and required_by
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require vgi

# For an http:// VGI_TEST_WORKER.
require httpfs

# Before any VGI catalog is attached there is nothing to report.
query I
SELECT count(*) FROM vgi_secret_types();
----
0

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

query TT
SELECT catalog_name, secret_type FROM vgi_secret_types() WHERE secret_type = 'vgi_example';
----
example	vgi_example

# Fixture wording and the port width differ across SDKs; assert only what all
# of them declare.
query I
SELECT description IS NOT NULL AND description <> '' FROM vgi_secret_types() WHERE secret_type = 'vgi_example';
----
true

# Parameters keep declaration order and the redact flag.
query TT
SELECT p.name, p.redact
FROM vgi_secret_types(catalog := 'example'), unnest(parameters) AS t(p)
WHERE secret_type = 'vgi_example';
----
secret_string	true
api_key	true
port	false
use_ssl	false
timeout	false

query T
SELECT p.type
FROM vgi_secret_types(catalog := 'example'), unnest(parameters) AS t(p)
WHERE secret_type = 'vgi_example' AND p.name = 'secret_string';
----
VARCHAR

# required_by names the schema-qualified functions that declare the requirement.
query I
SELECT list_contains(list_transform(required_by, lambda f: split_part(f, '.', 2)), 'return_secret_value')
FROM vgi_secret_types() WHERE secret_type = 'vgi_example';
----
true

# The catalog filter excludes other attachments.
query I
SELECT count(*) FROM vgi_secret_types(catalog := 'no_such_catalog');
----
0
