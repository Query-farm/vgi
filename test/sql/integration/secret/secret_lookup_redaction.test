# name: test/sql/integration/secret/secret_lookup_redaction.test
# description: Secret values delivered to a worker never surface where the user
#              can see them: the worker-registered type's redacted fields are
#              redacted in duckdb_secrets(), and the values appear in no EXPLAIN
#              output, no error text and no extension log record, although the
#              worker did receive them. Fixture contract:
#              docs/secret_lookup_fixtures.md.
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require-env VGI_SECRET_LOOKUP_FIXTURES

require vgi

require httpfs

statement ok
CALL enable_logging(level := 'debug');

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE SECRET (TYPE vgi_example, secret_string 'sk-conformance-redact-string', api_key 'sk-conformance-redact-key', port 4242);

# The worker received the values...

query TT
SELECT found, value FROM example.secret_value_by_type('api_key');
----
true	sk-conformance-redact-key

query TT
SELECT found, value FROM example.secret_value_required('secret_string');
----
true	sk-conformance-redact-string

# ...a field the worker did not mark redacted is shown (the secret is listed),
# while the redacted ones are not.

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = '__default_vgi_example' AND contains(secret_string, '4242');
----
1

query I
SELECT count(*) FROM duckdb_secrets() WHERE contains(secret_string, 'sk-conformance-redact');
----
0

# EXPLAIN shows the scan, never a secret value.

statement ok
PRAGMA explain_output = 'physical_only';

query II
EXPLAIN SELECT * FROM example.secret_value_by_type('api_key');
----
physical_plan	<!REGEX>:.*sk-conformance-redact.*

# An error raised while a secret of the type exists does not echo it: leave
# only a scoped secret, which the unscoped requirement does not resolve, and
# call the required function.

statement ok
CREATE SECRET conformance_scoped (TYPE vgi_example, secret_string 'sk-conformance-redact-scoped', api_key 'sk-conformance-redact-scoped', SCOPE 'vgi-conformance://only/');

statement ok
DROP SECRET __default_vgi_example;

statement error
SELECT * FROM example.secret_value_required('api_key');
----
<!REGEX>:.*sk-conformance-redact.*

# No extension log record carries a value. (DuckDB's own QueryLog records the
# CREATE SECRET statement text, which the extension cannot redact.)

query I
SELECT count(*) FROM duckdb_logs()
WHERE type <> 'QueryLog' AND (contains(message, 'sk-conformance-redact')
   OR contains(lower(message), lower(hex('sk-conformance-redact'))));
----
0

statement ok
DROP SECRET conformance_scoped;

statement ok
DETACH example;
