# name: test/sql/integration/secret/secret_lookup_by_name.test
# description: A secret requested by explicit NAME at bind (two-phase secret
#              request) reaches the worker; the name must also carry the
#              requested type. Fixture contract: docs/secret_lookup_fixtures.md.
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require-env VGI_SECRET_LOOKUP_FIXTURES

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE SECRET conformance_one (TYPE vgi_example, api_key 'key-one', port 1);

statement ok
CREATE SECRET conformance_two (TYPE vgi_example, api_key 'key-two', port 2);

# Each name selects its own secret, although both have the same type and scope.

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_name('conformance_one', 'api_key');
----
true	conformance_one	key-one

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_name('conformance_two', 'api_key');
----
true	conformance_two	key-two

# An unnamed secret is addressable by its default name.

statement ok
CREATE SECRET (TYPE vgi_example, api_key 'key-default');

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_name('__default_vgi_example', 'api_key');
----
true	__default_vgi_example	key-default

# A name that does not exist: not found, no error.

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_name('conformance_missing', 'api_key');
----
false	NULL	NULL

# A name that exists with a different type: not found.

statement ok
CREATE SECRET conformance_s3 (TYPE s3, KEY_ID 'AKIAVGICONFORMANCE', SECRET 'conformance-s3-secret');

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_name('conformance_s3', 'key_id');
----
false	NULL	NULL

statement ok
DROP SECRET conformance_s3;

statement ok
DROP SECRET __default_vgi_example;

statement ok
DROP SECRET conformance_one;

statement ok
DROP SECRET conformance_two;

statement ok
DETACH example;
