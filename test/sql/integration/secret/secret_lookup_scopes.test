# name: test/sql/integration/secret/secret_lookup_scopes.test
# description: Several secrets of the SAME type with different scopes reach one
#              bind together (each column keyed by name), and the worker selects
#              per path by the longest matching scope prefix, falling back to
#              the unscoped secret. secret_value_for_scope statically requires
#              vgi_example unscoped, for vgi-conformance://a/ and for
#              vgi-conformance://a/b/. Fixture contract:
#              docs/secret_lookup_fixtures.md.
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require-env VGI_SECRET_LOOKUP_FIXTURES

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
CREATE SECRET conformance_a (TYPE vgi_example, api_key 'key-a', SCOPE 'vgi-conformance://a/');

statement ok
CREATE SECRET conformance_ab (TYPE vgi_example, api_key 'key-ab', SCOPE 'vgi-conformance://a/b/');

statement ok
CREATE SECRET conformance_any (TYPE vgi_example, api_key 'key-any');

# The longest prefix wins: a/b/ beats a/ for a path under a/b/.

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://a/b/file.parquet', 'api_key');
----
true	conformance_ab	key-ab

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://a/other/file.parquet', 'api_key');
----
true	conformance_a	key-a

# No scope matches: the unscoped secret is the fallback.

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://z/file.parquet', 'api_key');
----
true	conformance_any	key-any

# Without the unscoped secret, a path no scope matches selects nothing...

statement ok
DROP SECRET conformance_any;

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://z/file.parquet', 'api_key');
----
false	NULL	NULL

# ...while the scoped paths still select their own secret.

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://a/b/c/d', 'api_key');
----
true	conformance_ab	key-ab

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://a/x', 'api_key');
----
true	conformance_a	key-a

# With only the outer scope left, a path under a/b/ falls to a/.

statement ok
DROP SECRET conformance_ab;

query TTT
SELECT found, secret_name, value FROM example.secret_value_for_scope('vgi-conformance://a/b/file.parquet', 'api_key');
----
true	conformance_a	key-a

statement ok
DROP SECRET conformance_a;

statement ok
DETACH example;
