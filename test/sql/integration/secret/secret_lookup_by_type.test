# name: test/sql/integration/secret/secret_lookup_by_type.test
# description: A secret required by TYPE (declared statically in the SDK's
#              simplest form, a bare type string) reaches the worker whatever
#              the secret is NAMED. The resolved-secrets batch keys each column
#              by the secret's unique DuckDB name, not its type, so an SDK that
#              looks a type up as a column name misses `__default_<type>`.
#              Fixture contract: docs/secret_lookup_fixtures.md.
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require-env VGI_SECRET_LOOKUP_FIXTURES

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# ============================================================================
# Optional secret absent: one row, found = false, no error.
# ============================================================================

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('api_key');
----
false	NULL	NULL

# A required secret that is absent fails the bind with an error naming the type.

statement error
SELECT * FROM example.secret_value_required('api_key');
----
<REGEX>:.*vgi_example.*

# ============================================================================
# Unnamed secret: DuckDB names it __default_vgi_example.
# ============================================================================

statement ok
CREATE SECRET (TYPE vgi_example, secret_string 'unnamed-string', api_key 'unnamed-key', port 1);

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('api_key');
----
true	__default_vgi_example	unnamed-key

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('secret_string');
----
true	__default_vgi_example	unnamed-string

# A field the secret does not carry is NULL, not an error.

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('no_such_field');
----
true	__default_vgi_example	NULL

query TTT
SELECT found, secret_name, value FROM example.secret_value_required('api_key');
----
true	__default_vgi_example	unnamed-key

statement ok
DROP SECRET __default_vgi_example;

# ============================================================================
# Named secret whose name differs from its type, still looked up by type.
# ============================================================================

statement ok
CREATE SECRET conformance_creds (TYPE vgi_example, secret_string 'named-string', api_key 'named-key', port 2);

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('api_key');
----
true	conformance_creds	named-key

query TTT
SELECT found, secret_name, value FROM example.secret_value_required('api_key');
----
true	conformance_creds	named-key

statement ok
DROP SECRET conformance_creds;

# Dropped again: back to absent (the result is not served from a stale cache).

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('api_key');
----
false	NULL	NULL

# A scoped secret of the type does not satisfy an unscoped requirement: DuckDB
# resolves an empty-scope lookup only to unscoped secrets.

statement ok
CREATE SECRET conformance_scoped (TYPE vgi_example, api_key 'scoped-key', SCOPE 'vgi-conformance://only/');

query TTT
SELECT found, secret_name, value FROM example.secret_value_by_type('api_key');
----
false	NULL	NULL

statement error
SELECT * FROM example.secret_value_required('api_key');
----
<REGEX>:.*vgi_example.*

statement ok
DROP SECRET conformance_scoped;

statement ok
DETACH example;
