# name: test/sql/integration/secret/secret_lookup_multi_type.test
# description: A function that requires secrets of two DIFFERENT types receives
#              both. secret_types_seen statically requires vgi_example (bare
#              type string) and s3 scoped to s3://vgi-conformance/ (DuckDB's s3
#              secrets default to the scope s3://, so they must be requested by
#              scope), and lists every secret it was delivered.
#              Fixture contract: docs/secret_lookup_fixtures.md.
# group: [vgi_integration_secret]

require-env VGI_TEST_WORKER

require-env VGI_SECRET_LOOKUP_FIXTURES

require vgi

require httpfs

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

query I
SELECT count(*) FROM example.secret_types_seen();
----
0

statement ok
CREATE SECRET (TYPE vgi_example, api_key 'multi-key');

query TTT
SELECT secret_name, secret_type, scope FROM example.secret_types_seen() ORDER BY secret_name;
----
__default_vgi_example	vgi_example	(empty)

statement ok
CREATE SECRET conformance_s3 (TYPE s3, KEY_ID 'AKIAVGICONFORMANCE', SECRET 'conformance-s3-secret', SCOPE 's3://vgi-conformance/');

query TTT
SELECT secret_name, secret_type, scope FROM example.secret_types_seen() ORDER BY secret_name;
----
__default_vgi_example	vgi_example	(empty)
conformance_s3	s3	s3://vgi-conformance/

# An s3 secret outside the requested scope is not delivered.

statement ok
CREATE SECRET conformance_s3_other (TYPE s3, KEY_ID 'AKIAOTHER', SECRET 'other-s3-secret', SCOPE 's3://somewhere-else/');

query TTT
SELECT secret_name, secret_type, scope FROM example.secret_types_seen() ORDER BY secret_name;
----
__default_vgi_example	vgi_example	(empty)
conformance_s3	s3	s3://vgi-conformance/

statement ok
DROP SECRET __default_vgi_example;

query TTT
SELECT secret_name, secret_type, scope FROM example.secret_types_seen() ORDER BY secret_name;
----
conformance_s3	s3	s3://vgi-conformance/

statement ok
DROP SECRET conformance_s3;

statement ok
DROP SECRET conformance_s3_other;

statement ok
DETACH example;
