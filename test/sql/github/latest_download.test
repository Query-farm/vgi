# name: test/sql/github/latest_download.test
# description: github-auto:// latest-release resolution + download/run against Query-farm/vgi-units (network)
# group: [vgi_github]

# Network-dependent: hits github.com (latest-release redirect), api.github.com
# and the release CDN. Gated like test/sql/integration/github/download.test:
#   VGI_GITHUB_NETWORK_TESTS=1 ./build/release/test/unittest test/sql/github/latest_download.test
require-env VGI_GITHUB_NETWORK_TESTS

require vgi

require httpfs

statement ok
SET vgi_github_cache_dir = '{TEST_DIR}/vgi_github_latest_cache';

# owner/repo (no @) resolves the latest release, then runs it like a pinned tag.
statement ok
ATTACH 'u' AS u (TYPE vgi, LOCATION 'github-auto://Query-farm/vgi-units');

query I
SELECT count(*) > 0 FROM duckdb_functions() WHERE database_name='u';
----
true

# The resolution is cached, and the downloaded release is the resolved tag.
query II
SELECT count(*), bool_and(source IN ('redirect', 'api') AND fresh) FROM vgi_github_latest() WHERE repo = 'vgi-units';
----
1	true

query I
SELECT count(*) FROM vgi_github_cache() c JOIN vgi_github_latest() l USING (owner, repo, tag) WHERE repo = 'vgi-units';
----
1

# @latest is the same thing; within the TTL it is answered from the cache.
query II
SELECT origin, pinned_location = 'github-auto://Query-farm/vgi-units@' || tag FROM vgi_github_resolve('github-auto://Query-farm/vgi-units@latest');
----
cache	true

statement ok
ATTACH 'u2' AS u2 (TYPE vgi, LOCATION 'github-auto://Query-farm/vgi-units@latest');

query I
SELECT count(*) FROM vgi_github_cache() WHERE repo = 'vgi-units';
----
1

# TTL 0 asks GitHub every time.
statement ok
SET vgi_github_latest_ttl_seconds = 0;

query I
SELECT origin FROM vgi_github_resolve('github-auto://Query-farm/vgi-units');
----
network

query I
SELECT flushed >= 1 FROM vgi_github_cache_flush();
----
true
