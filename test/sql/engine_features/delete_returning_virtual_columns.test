# name: test/sql/engine_features/delete_returning_virtual_columns.test
# description: Drift guard for VGI_ENGINE_DELETE_RETURNING_VIRTUAL_COLUMNS (duckdb/duckdb#28089). Tests gate on it with
#   require-env / require-env-not; the Makefile exports it from the engine tree.
#   Runs when it is 1 (feature present) and checks that the extension
#   was really compiled that way, so a wrong or missing variable fails here instead
#   of silently skipping, or wrongly running, the gated files.
#   See docs/upstream-duckdb-build.md.
# group: [vgi_engine_features]

require-env VGI_ENGINE_DELETE_RETURNING_VIRTUAL_COLUMNS 1

require vgi

query I
SELECT available FROM vgi_engine_features() WHERE feature = 'delete_returning_virtual_columns';
----
true
