VGI_SETTING(OAUTH_CACHE, "vgi_oauth_cache", VARCHAR, 0ULL, 0ULL, "auto,persistent,memory,none", false, "OAuth credential cache: auto (persistent on macOS/Windows, memory on Linux), persistent, memory, or none Scope: session. Takes effect: Captured by ATTACH authentication or a new vgi_catalogs call; existing authentication objects keep their cache mode. Platform: all. Choices: auto,persistent,memory,none.")
